local function restoreLight(which)
    if which == "bright" then
        Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows = origLight.Brightness, origLight.ClockTime, origLight.GlobalShadows
        Lighting.Ambient, Lighting.OutdoorAmbient = origLight.Ambient, origLight.OutdoorAmbient
    else
        Lighting.FogStart, Lighting.FogEnd = origLight.FogStart, origLight.FogEnd
    end
end
bind(Lighting.Changed:Connect(function()
    if CFG.FullBright or CFG.NoFog then applyLight() end
end))

