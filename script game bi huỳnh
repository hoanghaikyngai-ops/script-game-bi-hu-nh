------------------------------------------------------------------
local function flightStep()
    if not (inFlight and not reachedGate) then
        if thrustForce then clearThrust() end
        if steerState ~= 0 then setSteer(0) end
        State.pr = nil
        return
    end
    local r = planeRoot()
    if not r then return end
    local now = os.clock()
    local dt = now - (State.lastStep or now)
    State.lastStep = now
    baseY = baseY or r.Position.Y
    if not gateChosen then gateChosen = true; curGate = pickGate() end

    local pos = r.Position
    local vel = r.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local speed = hv.Magnitude
    local dir
    if speed > 3 then
        dir = hv.Unit
    else
        local l = r.CFrame.LookVector
        dir = Vector3.new(l.X, 0, l.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
        dir = dir.Unit
    end
    State.pr, State.dir = r, dir -- để bước Stepped tăng tốc dùng

    if curGate and curGate.Parent then
        local d = curGate.Position - pos
        if Vector3.new(d.X, 0, d.Z).Magnitude <= GATE_STOP + curGate.Size.Magnitude / 4 then
            reachedGate = true
            clearThrust()
            setSteer(0)
            if firetouchinterest then
                pcall(function() firetouchinterest(r, curGate, 0); firetouchinterest(r, curGate, 1) end)
            end
            notify("Cổng", "Đã chạm cổng cuối")
            return
        end
    end

    if CFG.KeepFlying and not r.Anchored and r ~= root() then
        ensureThrust(r)
        local g = workspace.Gravity
        local wantY = baseY + CFG.HoldHeight + (DG.climb == 1 and 40 or 0)
        local up = g + math.clamp((wantY - pos.Y) * 6, -g * 0.8, CFG.Lift)
        local push = speed < CFG.FlySpeed and CFG.Push or 0
        thrustForce.Force = Vector3.new(dir.X * push, up, dir.Z * push) * r.AssemblyMass
    elseif thrustForce then
        clearThrust()
    end

    if now - (State.lastFilter or 0) > 0.25 then
        State.lastFilter = now
        refreshAvoidFilter()
    end
    -- dùng tốc độ thực đo được (khi đang dịch CFrame thì vận tốc không phản ánh đúng)
    local sp = math.max(speed, State.actual or 0)
    local d = updateDodge(pos, dir, sp)
    local c = (d == 0) and updateCandy(pos, dir) or 0
    setSteer(d ~= 0 and d or c)

    -- né chủ động: đẩy thân máy bay sang ngang ngay, không chờ máy bay tự bẻ lái theo phím
    if d ~= 0 and CFG.DodgeAssist and DG.lat > 1 and not r.Anchored and r ~= root() then
        local side = Vector3.new(-dir.Z, 0, dir.X)
        r.CFrame = r.CFrame + side * d * DG.lat * dt
    end
end
bind(RunService.Heartbeat:Connect(function()
    local ok, err = pcall(flightStep)
    if not ok and State.lastErr ~= tostring(err) then
        State.lastErr = tostring(err)
        log("[LOI bay] " .. State.lastErr)
    end
end))

