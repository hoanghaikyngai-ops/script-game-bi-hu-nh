-- lower() cho cả chữ Việt hoa (Mở Khóa -> mở khóa)
local function viLower(s)
    s = tostring(s)
    local ok, res = pcall(function()
        local out = {}
        for _, cp in utf8.codes(s) do
            if cp >= 65 and cp <= 90 then cp += 32
            elseif cp >= 0xC0 and cp <= 0xDE and cp ~= 0xD7 then cp += 32
            elseif cp == 0x102 or cp == 0x110 or cp == 0x128 or cp == 0x168 or cp == 0x1A0 or cp == 0x1AF then cp += 1
            elseif cp >= 0x1EA0 and cp <= 0x1EF8 and cp % 2 == 0 then cp += 1 end
            out[#out + 1] = utf8.char(cp)
        end
        return table.concat(out)
    end)
    return ok and res or s:lower()
end
local function hasKw(s, list)
    s = viLower(s)
    for _, k in ipairs(list) do
        if s:find(k, 1, true) then return true end
    end
    return false
end

local function root()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function humanoid()
    local c = lp.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    local bb = inst:FindFirstAncestorWhichIsA("BillboardGui")
    if bb and bb.Adornee then return partOf(bb.Adornee) end
    local p = inst.Parent
    while p and p ~= workspace and p ~= game do
        if p:IsA("BasePart") then return p end
        if p:IsA("Model") then
            local bp = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
            if bp then return bp end
        end
        p = p.Parent
    end
end

