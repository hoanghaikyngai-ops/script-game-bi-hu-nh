    end
    local r = root()
    if not r then return nil, list end
    local key = u.part
    farmStatus = ("Đã chọn khu vực %s (x%s)"):format(u.name, tostring(u.mult))
    if force or key ~= lastUnlockPart or os.clock() - lastUnlockTime > 30 then
        lastUnlockPart, lastUnlockTime = key, os.clock()
        local cf = u.part.CFrame + Vector3.new(0, u.part.Size.Y / 2 + 3, 0)
        r.CFrame = cf
        log(("[FAM] chọn khu vực %s (x%s), đã teleport"):format(u.name, tostring(u.mult)))
