local function throwOnce()
    local cf = getThrowCFrame()
    if cf and root() and not nearSpot(cf) then
        root().CFrame = cf
        task.wait(0.4)
    end
    if #gates == 0 then scanGates() end
    flightId, ended = nil, false
    planeCache, baseY, curGate, gateChosen, reachedGate = nil, nil, nil, false, false
    lastPlaneScan = 0
    candyList, lastCandyScan = {}, 0

    holdThrow() -- giữ chuột, đủ lực mới thả
    throws += 1
    flightStart = os.clock()
    inFlight = true

    local t0 = os.clock()
    local seenPlane, still = nil, 0
    local reason = "hết giờ"
    local lastTick = os.clock()

    while State.Running and CFG.AutoThrow do
        local now = os.clock()
        local dt = now - lastTick
        lastTick = now
        local elapsed = now - t0

        if ended then reason = "server báo kết thúc"; break end
        if elapsed >= CFG.MaxFlight then reason = "quá thời gian bay"; break end
        if reachedGate then reason = "chạm cổng"; break end

        if Remote and flightId then pcall(function() Remote:FireServer("Steer", flightId, 0, CFG.SteerY) end) end

        local p = findPlane()
        if p and p ~= root() and not (lp.Character and p:IsDescendantOf(lp.Character)) then seenPlane = p end
        if seenPlane and not seenPlane.Parent and elapsed > 3 then
            ended = true; reason = "máy bay biến mất"; break
        end
        -- Khi đã bật tele cứu đáp đất thì không coi "đứng yên" là hết lượt (chỉ cổng / server / biến mất mới tính)
        local pr = seenPlane and seenPlane.Parent and partFromPlane(seenPlane)
        if (not CFG.AutoRescue) and elapsed > 5 and pr then
            if pr.AssemblyLinearVelocity.Magnitude < 2 then
                still += dt
                if still > CFG.StillTime then ended = true; reason = "máy bay đứng yên"; break end
            else
                still = 0
            end
        end
        task.wait(CFG.SteerRate)
    end

    if reachedGate and not ended then
        local t1 = os.clock()
        still = 0
        local last = os.clock()
        while State.Running and CFG.AutoThrow and not ended and os.clock() - t1 < CFG.GateWait do
            local now = os.clock()
            local dt = now - last
            last = now
            if seenPlane and not seenPlane.Parent then break end
            local pr = seenPlane and seenPlane.Parent and partFromPlane(seenPlane)
            if pr and pr.AssemblyLinearVelocity.Magnitude < 2 then
                still += dt
                if still > CFG.StillTime then break end
            else
                still = 0
            end
            task.wait(0.1)
        end
    end
    log("[INFO] Lượt " .. throws .. " xong: " .. reason)
end

