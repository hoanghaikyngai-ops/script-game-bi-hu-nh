local farmStatus, lastUnlockCheck, lastUnlockPart, lastUnlockTime = "tắt", 0, nil, 0
local function unlockBest(force)
    local list = findUnlocks()
    local u = list[1]
    if not u then
        farmStatus = "không thấy 'Mở khóa'"
        return nil, list
    end
    local key = u.part or u.btn
    farmStatus = ("Mở khóa nhân cao nhất: x%s (%s)"):format(tostring(u.mult), u.name)
    if force or key ~= lastUnlockPart or os.clock() - lastUnlockTime > 30 then
        lastUnlockPart, lastUnlockTime = key, os.clock()
        log(("[FAM] mở khóa %s (x%s)"):format(u.name, tostring(u.mult)))
        triggerUnlock(u)
    end
    return u, list
end

