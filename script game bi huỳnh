local inFlight, baseY, planeCache, reachedGate = false, nil, nil, false
local lastPlaneScan = 0
local throwStartT = 0
local findPlane

do
    local spawnInfo = setmetatable({}, {__mode = "k"})
    local OWNER_KEYS = {"OwnerUserId", "Owner", "UserId", "OwnerId", "Player", "PlayerName"}

    local function recordSpawn(v, part)
        local r = root()
        if part and r then spawnInfo[v] = {t = os.clock(), d = (part.Position - r.Position).Magnitude} end
    end

    bind(workspace.DescendantAdded:Connect(function(v)
        if not (v:IsA("Model") or v:IsA("BasePart")) then return end
        if not v.Name:lower():find("plane") then return end
        if v:IsA("BasePart") then
            recordSpawn(v, v)
        else
            task.defer(function()
                if v.Parent then recordSpawn(v, v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)) end
            end)
        end
    end))

    local function ownedByOther(v)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                if p.Character and v:IsDescendantOf(p.Character) then return true end
                local n = v.Name:lower()
                local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
                local un, dn = p.Name:lower(), p.DisplayName:lower()
                if (#un >= 3 and n:find(un, 1, true)) or pn == un or pn == dn or n:find(tostring(p.UserId), 1, true) then
                    return true
                end
            end
        end
        for _, key in ipairs(OWNER_KEYS) do
            local a = v:GetAttribute(key)
            if a ~= nil and a ~= lp.UserId and a ~= lp.Name and a ~= lp.DisplayName and tostring(a) ~= tostring(lp.UserId) then
                return true
            end
        end
        local ov = v:FindFirstChild("Owner") or v:FindFirstChild("OwnerUserId")
        if ov and ov:IsA("ValueBase") then
            local val = ov.Value
            if val ~= lp and val ~= lp.UserId and val ~= lp.Name then return true end
        end
        return false
    end

    local function isMine(v)
        local id = flightId and flightId:lower()
        if id and v.Name:lower() == id then return true end
        for _, key in ipairs(OWNER_KEYS) do
            local a = v:GetAttribute(key)
            if a ~= nil and (a == lp.UserId or a == lp.Name or tostring(a) == tostring(lp.UserId)) then return true end
        end
        local ov = v:FindFirstChild("Owner") or v:FindFirstChild("OwnerUserId")
        if ov and ov:IsA("ValueBase") and (ov.Value == lp or ov.Value == lp.UserId or ov.Value == lp.Name) then return true end
        return false
    end

    function findPlane()
        if planeCache and planeCache.Parent then return planeCache end
        planeCache = nil
        if os.clock() - lastPlaneScan < 0.3 then return nil end
        lastPlaneScan = os.clock()
        local best, bestD, fast, fastV
        local rr = root()
        local allowFast = rr and (os.clock() - throwStartT) > 0.8
            and (#Players:GetPlayers() <= 1 or type(isnetworkowner) == "function")
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and not (lp.Character and v:IsDescendantOf(lp.Character)) then
                if isMine(v) then
                    planeCache = v
                    return v
                end
                if v.Name:lower():find("plane") and not ownedByOther(v) then
                    local si = spawnInfo[v]
                    if si and si.t >= throwStartT - 0.2 and si.d <= CFG.PlaneSpawnDist then
                        if not bestD or si.d < bestD then best, bestD = v, si.d end
                    end
                end
                if allowFast and v:IsA("BasePart") and not v.Anchored then
                    local sp = v.AssemblyLinearVelocity.Magnitude
                    if sp > 25 and (not fastV or sp > fastV) and (v.Position - rr.Position).Magnitude < 400 then
                        local okOwn = true
                        if type(isnetworkowner) == "function" then
                            local ok2, res = pcall(isnetworkowner, v)
                            okOwn = ok2 and res
                        end
                        if okOwn and not ownedByOther(v) then fast, fastV = v, sp end
                    end
                end
            end
        end
        if best then
            planeCache = best
            log("[BAY] nhận máy bay của mình: " .. best:GetFullName())
            return best
        elseif fast then
            planeCache = fast
            log("[BAY] không thấy tên 'plane' -> lấy vật bay nhanh nhất của mình: " .. fast:GetFullName())
            return fast
        end
        return nil
    end
end

local function partFromPlane(p)
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
end

local function planeRoot()
    local p = findPlane()
    if not p then return root() end
    return partFromPlane(p) or root()
end

-- Cổng cuối
local GATE_KW = {"cổng", "cong", "gate", "finish", "goal", "đích", "dich", "portal", "ketthuc"}
local gates, gateOverride, curGate, gateChosen = {}, nil, nil, false

local function scanGates()
    gates = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = v.Name:lower()
            local pn = v.Parent and v.Parent.Name:lower() or ""
            for _, k in ipairs(GATE_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    gates[#gates + 1] = v
                    break
                end
            end
        end
    end
end

local function pickGate()
    if gateOverride and gates[gateOverride] and gates[gateOverride].Parent then
        return gates[gateOverride]
    end
    local r = planeRoot()
    if not r then return nil end
    local l = r.CFrame.LookVector
    local look = Vector3.new(l.X, 0, l.Z)
    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local best, bestD
    for _, g in ipairs(gates) do
        if g.Parent then
            local d = g.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 40 and flat.Magnitude < 20000 and flat.Unit:Dot(look) > 0.5 then
                if not bestD or flat.Magnitude > bestD then best, bestD = g, flat.Magnitude end
            end
        end
    end
    return best
end

-- Lộ trình tọa độ đặt sẵn + tia dẫn đường
local Route = {pts = {}, idx = 1}
local routeFolder, guidePart

local function routeSave()
    local t = {}
    for _, v in ipairs(Route.pts) do t[#t + 1] = ("%.1f,%.1f,%.1f"):format(v.X, v.Y, v.Z) end
    CFG.Route = table.concat(t, ";")
    saveCfg()
end
local function routeLoad()
    Route.pts = {}
    for chunk in tostring(CFG.Route):gmatch("[^;]+") do
        local x, y, z = chunk:match("(%-?[%d%.]+),(%-?[%d%.]+),(%-?[%d%.]+)")
        if x then Route.pts[#Route.pts + 1] = Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    end
end

local function routeLine(a, b, color, thick)
    local total = (b - a).Magnitude
    if total < 0.5 then return end
    local dir, done = (b - a).Unit, 0
    while done < total do
        local seg = math.min(2000, total - done)
        local p0, p1 = a + dir * done, a + dir * (done + seg)
        new("Part", {Name = "Line", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            CastShadow = false, Material = Enum.Material.Neon, Color = color,
            Size = Vector3.new(thick, thick, seg), CFrame = CFrame.lookAt((p0 + p1) / 2, p1)}, routeFolder)
        done += seg
    end
end

local function routeDraw()
    if routeFolder and routeFolder.Parent then routeFolder:ClearAllChildren()
    else routeFolder = new("Folder", {Name = "HHubRoute"}, workspace) end
    if Route.info then
        Route.info.Text = (#Route.pts == 0) and "Chưa có điểm nào." or
            ("Lộ trình: %d điểm (đang tới điểm %d). Điểm cuối xong -> máy bay tự lái tới cổng."):format(#Route.pts, math.min(Route.idx, #Route.pts))
    end
    if not CFG.RouteShow then return end
    local prev
    for i, p in ipairs(Route.pts) do
        local m = new("Part", {Name = "Node", Shape = Enum.PartType.Ball, Size = Vector3.one * 6, Anchored = true,
            CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon,
            Color = Color3.fromRGB(255, 220, 0), Position = p}, routeFolder)
        local bb = new("BillboardGui", {Size = UDim2.fromOffset(60, 24), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 5, 0)}, m)
        new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tostring(i),
            TextColor3 = Color3.new(1, 1, 0), TextStrokeTransparency = 0, Font = Enum.Font.GothamBlack, TextSize = 18}, bb)
        if prev then routeLine(prev, p, Color3.fromRGB(0, 200, 255), 1.2) end
        prev = p
    end
end

local function routeAdd(v)
    Route.pts[#Route.pts + 1] = v
    routeSave(); routeDraw()
    notify("Lộ trình", ("Điểm %d: %d, %d, %d"):format(#Route.pts, v.X, v.Y, v.Z))
end
local function routeUndo()
    table.remove(Route.pts); Route.idx = 1
    routeSave(); routeDraw()
end
local function routeClear()
    Route.pts, Route.idx = {}, 1
    routeSave(); routeDraw()
end

-- tia dẫn đường từ máy bay tới điểm đang nhắm
local function updateGuide(a, b)
    if not (a and b and CFG.RouteShow) then
        if guidePart then guidePart.Transparency = 1 end
        return
    end
    if not (guidePart and guidePart.Parent) then
        routeFolder = (routeFolder and routeFolder.Parent) and routeFolder or new("Folder", {Name = "HHubRoute"}, workspace)
        guidePart = new("Part", {Name = "Guide", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            CastShadow = false, Material = Enum.Material.Neon, Color = Color3.fromRGB(80, 255, 120)}, routeFolder)
    end
    local v = b - a
    local len = v.Magnitude
    if len < 1 then guidePart.Transparency = 1 return end
    len = math.min(len, 2000)
    local e = a + v.Unit * len
    guidePart.Transparency = 0.2
    guidePart.Size = Vector3.new(0.6, 0.6, len)
    guidePart.CFrame = CFrame.lookAt((a + e) / 2, e)
end

