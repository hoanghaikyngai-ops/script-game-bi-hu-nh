-- Theo dõi các "xx%" MỚI hiện / đổi chữ sau khi bấm (không nhận % có sẵn trước khi bấm)
local function newTracker()
    local T = {items = {}, ignored = setmetatable({}, {__mode = "k"}),
        base = setmetatable({}, {__mode = "k"}), lastScan = -10}
    function T:snapshot()
        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        for _, o in ipairs(pg:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text:find("%d%s*%%") and visibleChain(o) then
                self.base[o] = o.Text
            end
        end
    end
    function T:scan(now)
        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        self.lastScan = now
        for _, o in ipairs(pg:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton")) and not self.items[o] and not self.ignored[o] then
                if o.Text:find("%d%s*%%") and visibleChain(o) then
                    if self.base[o] == nil or self.base[o] ~= o.Text then
                        self.items[o] = {v = readObj(o), born = now, tChange = nil, n = 0, hist = {}}
                    end
                end
            end
        end
    end
    function T:update(now)
        for o, s in pairs(self.items) do
            if not o.Parent then
                self.items[o] = nil
            else
                local v = readObj(o)
                if v and s.v and math.abs(v - s.v) > 1e-4 then
                    s.n += 1
                    s.tChange = now
                    local h = s.hist
                    h[#h + 1] = {now, v}
                    if #h > 6 then table.remove(h, 1) end
                end
                if v then s.v = v end
                if not s.manual and now - (s.tChange or s.born) > 1.5 then
                    self.items[o] = nil
                    self.ignored[o] = true
                end
            end
        end
    end
    function T:best()
        local bo, bs, bscore
        for o, s in pairs(self.items) do
            if s.n >= 1 or s.manual then
                local score = s.n + (nameHas(o) and 5 or 0) + (s.manual and 100 or 0)
                if not bscore or score > bscore then bo, bs, bscore = o, s, score end
            end
        end
        return bs, bo
    end
    return T
end

local function rateOf(s)
    local h = s.hist
    if #h < 2 then return 0 end
    local a, b = h[1], h[#h]
    local dt = b[1] - a[1]
    if dt <= 0 then return 0 end
    return (b[2] - a[2]) / dt
end

-- Giữ chuột, đoán trước rồi thả đúng 100%
local function holdThrow(manual)
    local T = newTracker()
    local t00 = os.clock()
    T:snapshot() -- chụp mọi % đang hiện sẵn TRƯỚC khi bấm
    if meterObj and meterObj.Parent then
        T.items[meterObj] = {v = readObj(meterObj), born = t00, n = 0, hist = {}, manual = true}
    end
    local x, y = pickClickPoint()
    pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
    local t0 = os.clock()
    mouseBtn(x, y, true)
    local goal = CFG.PowerGoal
    local lead = math.clamp(CFG.Lead, 0, 0.15)
    local released, active, vRel, lastV = false, nil, nil, nil

    while State.Running and (CFG.AutoThrow or manual) do
        local now = os.clock()
        local el = now - t0
        if now - T.lastScan > 0.12 then T:scan(now) end
        T:update(now)
        local s, o = T:best()
        if s and s.v then
            active = o
            lastV, lastPower, lastMeterName = s.v, s.v, o.Name
            local trusted = s.manual or s.n >= 2
            if trusted and el > 0.1 then
                local rate = (s.n >= 3) and rateOf(s) or 0
                local pred = s.v
                if rate > 0 and rate < 4 and s.v >= 0.5 then pred = s.v + rate * lead end
                if s.v >= goal - 0.002 or pred >= goal - 0.002 then
                    released, vRel = true, s.v
                    break
                end
            end
        end
        if el >= CFG.MaxCharge then break end
        if (not s) and el >= math.max(CFG.ChargeHold, 2) then break end
        RunService.RenderStepped:Wait()
    end
    mouseBtn(x, y, false)
    local tUp = os.clock()

    local finalV, lastChange = lastV, nil
    if released and active and active.Parent then
        local lastVal = vRel
        local t1 = os.clock()
        while os.clock() - t1 < 0.45 do
            RunService.RenderStepped:Wait()
            local v = readObj(active)
            if v then
                if lastVal and math.abs(v - lastVal) > 1e-4 then lastChange = os.clock() end
                lastVal, finalV = v, v
            end
            if lastChange and os.clock() - lastChange > 0.12 then break end
            if (not lastChange) and os.clock() - t1 > 0.15 then break end
        end
        if CFG.AutoLead and finalV and finalV >= 0.3 then
            local newLead = CFG.Lead
            if finalV < goal - 0.015 then
                newLead = newLead - 0.015 -- thiếu lực -> nhả MUỘN hơn
            elseif lastChange then
                local L = lastChange - tUp
                if L > 0.005 and L < 0.15 then newLead = CFG.Lead * 0.7 + L * 0.3 end
            end
            newLead = math.clamp(newLead, 0, 0.15)
            if math.abs(newLead - CFG.Lead) > 0.001 then CFG.Lead = newLead; saveCfg() end
        end
    end

    if released then
        log(("[THROW] thả ở %.0f%%, lực cuối %.0f%%, đoán trước %.0fms"):format(
            (vRel or 0) * 100, (finalV or 0) * 100, CFG.Lead * 1000))
    elseif lastV then
        log(("[THROW] hết giờ giữ, lực cuối %.0f%%"):format(lastV * 100))
    else
        log("[THROW] không thấy % nào đang đổi -> dùng nút 'Chọn thanh lực'")
    end
    return released
end

