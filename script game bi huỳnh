local clearThrust
do
    local RIG_COL = {rear = Color3.fromRGB(255, 60, 60), left = Color3.fromRGB(60, 140, 255),
        right = Color3.fromRGB(60, 140, 255), bottom = Color3.fromRGB(60, 255, 120)}
    local RIG_GIGN = {"candy", "kẹo", "lolli", "sweet", "sugar", "coin", "gate", "cổng", "finish"}
    local rigGP = RaycastParams.new()
    rigGP.FilterType = Enum.RaycastFilterType.Exclude
    rigGP.IgnoreWater = false
    Rig.active, Rig.climbCmd, Rig.lat = false, 0, 0

    function Rig.clear()
        if Rig.folder then pcall(function() Rig.folder:Destroy() end) end
        Rig.folder, Rig.pp, Rig.parts, Rig.forces = nil, nil, nil, nil
        Rig.active, Rig.lat, Rig.climbCmd = false, 0, 0
        Rig.gY, Rig.gHere, Rig.minY = nil, nil, nil
    end
    function clearThrust() Rig.clear() end

    local function rigAlive(pp)
        if not (Rig.folder and Rig.folder.Parent and Rig.pp == pp and Rig.parts) then return false end
        for _, p in pairs(Rig.parts) do
            if not p.Parent then return false end
        end
        return true
    end

    function Rig.ensure(pp)
        if rigAlive(pp) then
            local t = CFG.RigShow and 0.35 or 1
            for _, p in pairs(Rig.parts) do
                if p.Transparency ~= t then p.Transparency = t end
            end
            return
        end
        Rig.clear()
        local rf = new("Folder", {Name = "HHubRig"}, workspace)
        local parts, forces = {}, {}
        local function mk(name, off, size)
            local p = new("Part", {Name = "HHubRig_" .. name, Size = size, CFrame = pp.CFrame * off, Massless = true,
                CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Anchored = false,
                Material = Enum.Material.Neon, Color = RIG_COL[name], Transparency = CFG.RigShow and 0.35 or 1}, rf)
            new("WeldConstraint", {Part0 = p, Part1 = pp}, p)
            local att = new("Attachment", {}, p)
            forces[name] = new("VectorForce", {Attachment0 = att, RelativeTo = Enum.ActuatorRelativeTo.World,
                ApplyAtCenterOfMass = true, Force = Vector3.zero}, p)
            parts[name] = p
        end
        local sx, sy, sl = math.max(pp.Size.X, 1), math.max(pp.Size.Y, 0.5), math.max(pp.Size.Z, 1)
        mk("rear", CFrame.new(0, 0, sl / 2 + 1.2), Vector3.new(sx * 0.6, sy, 1.5))
        mk("left", CFrame.new(-(sx / 2 + 1.2), 0, 0), Vector3.new(1.5, sy, sl * 0.5))
        mk("right", CFrame.new(sx / 2 + 1.2, 0, 0), Vector3.new(1.5, sy, sl * 0.5))
        mk("bottom", CFrame.new(0, -(sy / 2 + 1.2), 0), Vector3.new(sx * 0.8, 1, sl * 0.6))
        Rig.folder, Rig.pp, Rig.parts, Rig.forces = rf, pp, parts, forces
    end

    local function rigBaseFilter()
        local l = {}
        if lp.Character then l[#l + 1] = lp.Character end
        if planeCache then l[#l + 1] = planeCache end
        if Rig.folder then l[#l + 1] = Rig.folder end
        if routeFolder then l[#l + 1] = routeFolder end
        if fx.f then l[#l + 1] = fx.f end
        return l
    end

    local function rigGroundY(x, y, z, len, base)
        local filt = base
        rigGP.FilterDescendantsInstances = filt
        for _ = 1, 10 do
            local res = workspace:Raycast(Vector3.new(x, y, z), Vector3.new(0, -len, 0), rigGP)
            if not res then return nil end
            local i = res.Instance
            local ghost = false
            if not i:IsA("Terrain") then
                ghost = (not i.CanCollide) or i.Transparency >= 0.95
                if not ghost then
                    local n = i.Name:lower()
                    local pn = (i.Parent and i.Parent ~= workspace) and i.Parent.Name:lower() or ""
                    for _, k in ipairs(RIG_GIGN) do
                        if n:find(k, 1, true) or pn:find(k, 1, true) then ghost = true break end
                    end
                end
            end
            if not ghost then return res.Position.Y end
            if filt == base then filt = table.clone(base) end
            filt[#filt + 1] = i
            rigGP.FilterDescendantsInstances = filt
        end
        return nil
    end

    function Rig.ground(pos, dir, speed, plane)
        if not CFG.RigGround then
            Rig.gY, Rig.gHere, Rig.minY = nil, nil, nil
            return nil, nil
        end
        local now = os.clock()
        if now - (Rig.lastG or 0) < 0.04 then return Rig.gY, Rig.minY end
        Rig.lastG = now
        local halfY = (plane and plane:IsA("BasePart")) and plane.Size.Y / 2 or 1
        local base = rigBaseFilter()
        local look = math.clamp(speed * CFG.GroundLook, 0, 600)
        local fr = look > 5 and {0, 0.35, 0.7, 1} or {0}
        local best, here
        for i, f in ipairs(fr) do
            local p = pos + dir * (look * f)
            local y = rigGroundY(p.X, pos.Y + 3, p.Z, 303, base)
            if i == 1 then here = y end
            if y and (not best or y > best) then best = y end
        end
        Rig.gY, Rig.gHere, Rig.halfY = best, here, halfY
        Rig.minY = best and (best + CFG.GroundClear + halfY) or nil
        return Rig.gY, Rig.minY
    end

    function Rig.apply(r, dir, push, up, turn, speed)
        local f = Rig.forces
        if not f then return end
        local mass = r.AssemblyMass
        local side = Vector3.new(-dir.Z, 0, dir.X)
        f.rear.Force = Vector3.new(dir.X * push, 0, dir.Z * push) * mass
        f.bottom.Force = Vector3.new(0, up, 0) * mass
        local acc = 0
        if turn ~= 0 then
            acc = math.clamp(turn * math.max(speed, 20), -CFG.RigSideMax, CFG.RigSideMax)
        end
        local sf = side * (acc * mass)
        f.left.Force = acc > 0 and sf or Vector3.zero
        f.right.Force = acc < 0 and sf or Vector3.zero
        Rig.lat, Rig.active = acc, true
    end

    function Rig.floorGuard(r, pos, vel)
        local gh = Rig.gHere
        if not (CFG.RigGround and gh) then return false end
        local bottom = pos.Y - (Rig.halfY or 1)
        local safe = gh + 1.5
        if bottom < safe then
            r.CFrame = r.CFrame + Vector3.new(0, math.min(safe - bottom, 10), 0)
            if vel.Y < 0 then r.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z) end
            return true
        end
        return false
    end
end

