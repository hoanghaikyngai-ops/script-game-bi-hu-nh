local lastBoost = 0
local function fireBoost()
    if CFG.BoostRemote == "" or not folder then return end
    local rm = folder:FindFirstChild(CFG.BoostRemote)
    if not rm then return end
    local args, n = {}, 0
    for tok in CFG.BoostArgs:gmatch("[^,]+") do
        tok = tok:match("^%s*(.-)%s*$")
        local v
        if tok == "$id" then v = flightId
        elseif tok == "$mult" then v = CFG.SpeedMult
        elseif tok == "$speed" then v = math.floor(State.actual or 0)
        elseif tok == "$steer" then v = steerState
        elseif tok == "$climb" then v = Rig.climbCmd
        elseif tok == "true" then v = true
        elseif tok == "false" then v = false
        elseif tonumber(tok) then v = tonumber(tok)
        else v = tok end
        n += 1; args[n] = v
    end
    pcall(function()
        if rm:IsA("RemoteFunction") then rm:InvokeServer(table.unpack(args, 1, n))
        else rm:FireServer(table.unpack(args, 1, n)) end
    end)
end

local function throwOnce()
    local cf = getThrowCFrame()
    if cf and root() and not nearSpot(cf) then
        root().CFrame = cf
        task.wait(0.4)
    end
    if #gates == 0 then scanGates() end
    flightId, ended = nil, false
    planeCache, baseY, curGate, gateChosen, reachedGate = nil, nil, nil, false, false
    lastPlaneScan, lastHeavy = 0, 0
