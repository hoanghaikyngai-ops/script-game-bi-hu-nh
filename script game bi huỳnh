local clickX2Strength
do
    local x2ClickState = setmetatable({}, {__mode = "k"})
    local function cleanGuiText(value)
        value = tostring(value or ""):gsub("<[^>]->", ""):lower()
        value = value:gsub("%s+", " ")
        return value
    end
    local function isX2StrengthText(value)
        local t = cleanGuiText(value)
        local strength = t:find("x2 sức mạnh", 1, true) or t:find("x2 suc manh", 1, true)
            or t:find("sức mạnh x2", 1, true) or t:find("suc manh x2", 1, true)
            or t:find("2x sức mạnh", 1, true) or t:find("2x suc manh", 1, true)
        local power = t:find("x2 power", 1, true) or t:find("2x power", 1, true)
        return strength ~= nil and power == nil
    end
    local function circleClickTarget(labelObj)
        local p, best, bestScore = labelObj, nil, math.huge
        local depth = 0
        while p and p:IsA("GuiObject") and depth < 7 do
            local size = p.AbsoluteSize
            if size.X >= 24 and size.Y >= 24 and size.X <= 360 and size.Y <= 360 then
                local squareError = math.abs(1 - size.X / math.max(size.Y, 1))
                if p:IsA("GuiButton") then return p end
                if squareError <= 0.38 then
                    local score = squareError * 100 + depth * 0.5
                    if score < bestScore then best, bestScore = p, score end
                end
            end
            p = p.Parent
            depth += 1
        end
        return best or labelObj
    end
    function clickX2Strength()
        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if not pg then return false end
        for obj in pairs(x2ClickState) do
            if not obj.Parent or not visibleChain(obj) then x2ClickState[obj] = nil end
        end
        for _, v in ipairs(pg:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox")) and v.Visible
                and isX2StrengthText(v.Text) and visibleChain(v) then
                local hit = circleClickTarget(v)
                if hit and hit.Parent and visibleChain(hit) then
                    local state = x2ClickState[hit]
                    if not state then state = {tries = 0, last = 0}; x2ClickState[hit] = state end
                    if state.tries < 3 and os.clock() - state.last >= 0.6 then
                        local size, pos = hit.AbsoluteSize, hit.AbsolutePosition
                        if size.X > 0 and size.Y > 0 then
                            local sg = hit:FindFirstAncestorWhichIsA("ScreenGui")
                            local inset = (sg and sg.IgnoreGuiInset) and 0 or GuiService:GetGuiInset().Y
                            local x, y = pos.X + size.X * 0.5, pos.Y + size.Y * 0.5 + inset
                            pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
                            mouseBtn(x, y, true)
                            task.wait(0.055)
                            mouseBtn(x, y, false)
                            if state.tries >= 1 and hit:IsA("GuiButton") and type(firesignal) == "function" then
                                pcall(firesignal, hit.MouseButton1Click)
                                pcall(firesignal, hit.Activated)
                            end
                            state.tries += 1
                            state.last = os.clock()
                            log(("[X2] click vòng tròn x2 sức mạnh (%d/3) tại %d,%d"):format(state.tries, math.floor(x), math.floor(y)))
                            return true
                        end
                    end
                end
            end
        end
        return false
    end
end

