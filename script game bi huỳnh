-- ĐÍCH CUỐI + LỘ TRÌNH
------------------------------------------------------------------
local Route = {pts = {}, idx = 1}
local routeFolder
local Rig = {}

local function finalPos()
    if CFG.FinalSet then return Vector3.new(CFG.FinalX, CFG.FinalY, CFG.FinalZ) end
    return nil
end
local function setFinal(v)
    if v then CFG.FinalX, CFG.FinalY, CFG.FinalZ, CFG.FinalSet = v.X, v.Y, v.Z, true
    else CFG.FinalSet = false end
    saveCfg()
end

local function wpTarget()
    if CFG.UseRoute and Route.idx <= #Route.pts then return Route.pts[Route.idx] end
    if CFG.UseWaypoint and CFG.WpSet then return Vector3.new(CFG.WpX, CFG.WpY, CFG.WpZ) end
    return nil
end
local function setWaypoint(v)
    CFG.WpX, CFG.WpY, CFG.WpZ, CFG.WpSet = v.X, v.Y, v.Z, true
    saveCfg()
end
-- điểm đích cuối cùng (để vẽ / né / ESP): đích đặt tay > cổng đang chọn
local function destPos()
    local f = finalPos()
    if f then return f end
    if curGate and curGate.Parent then return curGate.Position end
    if State.gateSel and State.gateSel.Parent then return State.gateSel.Position end
    return nil
end

local function routeSave()
    local t = {}
    for _, v in ipairs(Route.pts) do t[#t + 1] = ("%.1f,%.1f,%.1f"):format(v.X, v.Y, v.Z) end
    CFG.Route = table.concat(t, ";")
    saveCfg()
end
local function routeLoad()
    Route.pts = {}
    for chunk in tostring(CFG.Route):gmatch("[^;]+") do
        local x, y, z = chunk:match("(%-?[%d%.]+),(%-?[%d%.]+),(%-?[%d%.]+)")
        if x then Route.pts[#Route.pts + 1] = Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    end
end

local function routeLine(a, b, color, thick)
    local total = (b - a).Magnitude
    if total < 0.5 then return end
    local dir, done = (b - a).Unit, 0
    while done < total do
        local seg = math.min(2000, total - done)
        local p0, p1 = a + dir * done, a + dir * (done + seg)
        new("Part", {Name = "Line", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            CastShadow = false, Material = Enum.Material.Neon, Color = color,
            Size = Vector3.new(thick, thick, seg), CFrame = CFrame.lookAt((p0 + p1) / 2, p1)}, routeFolder)
        done += seg
    end
end

local function routeDraw()
    if routeFolder and routeFolder.Parent then routeFolder:ClearAllChildren()
    else routeFolder = new("Folder", {Name = "HHubRoute"}, workspace) end
    if Route.info then
        Route.info.Text = (#Route.pts == 0) and "Chưa có điểm nào." or
            ("Lộ trình: %d điểm (đang tới điểm %d). Xong điểm cuối -> bay tới ĐÍCH."):format(#Route.pts, math.min(Route.idx, #Route.pts))
    end
    if not CFG.RouteShow then return end
    local prev
    for i, p in ipairs(Route.pts) do
        local m = new("Part", {Name = "Node", Shape = Enum.PartType.Ball, Size = Vector3.one * 6, Anchored = true,
            CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon,
            Color = Color3.fromRGB(255, 220, 0), Position = p}, routeFolder)
        local bb = new("BillboardGui", {Size = UDim2.fromOffset(60, 24), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 5, 0)}, m)
        new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tostring(i),
            TextColor3 = Color3.new(1, 1, 0), TextStrokeTransparency = 0, Font = Enum.Font.GothamBlack, TextSize = 18}, bb)
        if prev then routeLine(prev, p, Color3.fromRGB(0, 200, 255), 1.2) end
        prev = p
    end
end

local function routeAdd(v)
    Route.pts[#Route.pts + 1] = v
    routeSave(); routeDraw()
    notify("Lộ trình", ("Điểm %d: %d, %d, %d"):format(#Route.pts, v.X, v.Y, v.Z))
end
local function routeUndo()
    table.remove(Route.pts); Route.idx = 1
    routeSave(); routeDraw()
end
local function routeClear()
    Route.pts, Route.idx = {}, 1
    routeSave(); routeDraw()
end

local function autoRouteToGate()
    local g = destPos()
    if not g then
        if #gates == 0 then scanGates() end
        local pg = pickGate()
        if pg then g = pg.Position end
    end
    local r = (inFlight and planeRoot()) or root()
    if not (r and g) then return notify("Lộ trình", "Không có đích để tạo lộ trình") end
    local startPos = r.Position
    local flyY = startPos.Y + CFG.HoldHeight
    local delta = Vector3.new(g.X - startPos.X, 0, g.Z - startPos.Z)
    local totalDist = delta.Magnitude
    if totalDist < 30 then return notify("Lộ trình", "Bạn đã ở ngay gần đích rồi") end
    Route.pts, Route.idx = {}, 1
    local step = math.max(50, CFG.AutoRouteStep or 180)
    local count = math.max(1, math.floor(totalDist / step))
    for i = 1, count do
        Route.pts[#Route.pts + 1] = Vector3.new(startPos.X, flyY, startPos.Z) + delta * (i / count)
    end
    routeSave(); routeDraw()
    notify("Lộ trình", ("Đã tạo %d điểm thẳng tới đích (%d stud)"):format(#Route.pts, math.floor(totalDist)))
end

bind(UserInputService.InputBegan:Connect(function(input, processed)
    if not State.pickRoute or processed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local inset = GuiService:GetGuiInset()
    local ray = cam:ViewportPointToRay(input.Position.X, input.Position.Y + inset.Y)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ex = {}
    if lp.Character then ex[#ex + 1] = lp.Character end
    if routeFolder then ex[#ex + 1] = routeFolder end
    rp.FilterDescendantsInstances = ex
    local res = workspace:Raycast(ray.Origin, ray.Direction * 5000, rp)
    if res then routeAdd(res.Position + Vector3.new(0, CFG.RouteLift, 0))
    else notify("Lộ trình", "Không trúng gì, thử lại") end
end))

