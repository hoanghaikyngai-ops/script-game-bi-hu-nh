    local OWNER_KEYS = {"OwnerUserId", "Owner", "UserId", "OwnerId", "Player", "PlayerName"}

    local function recordSpawn(v, part)
        local r = root()
        if part and r then spawnInfo[v] = {t = os.clock(), d = (part.Position - r.Position).Magnitude} end
    end

    bind(workspace.DescendantAdded:Connect(function(v)
        if not (v:IsA("Model") or v:IsA("BasePart")) then return end
        if not v.Name:lower():find("plane") then return end
        if v:IsA("BasePart") then
            recordSpawn(v, v)
        else
            task.defer(function()
                if v.Parent then recordSpawn(v, v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)) end
            end)
        end
    end))

    local function ownedByOther(v)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                if p.Character and v:IsDescendantOf(p.Character) then return true end
                local n = v.Name:lower()
                local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
                local un, dn = p.Name:lower(), p.DisplayName:lower()
                if (#un >= 3 and n:find(un, 1, true)) or pn == un or pn == dn or n:find(tostring(p.UserId), 1, true) then
                    return true
                end
            end
        end
        for _, key in ipairs(OWNER_KEYS) do
            local a = v:GetAttribute(key)
            if a ~= nil and a ~= lp.UserId and a ~= lp.Name and a ~= lp.DisplayName and tostring(a) ~= tostring(lp.UserId) then
                return true
            end
        end
        local ov = v:FindFirstChild("Owner") or v:FindFirstChild("OwnerUserId")
        if ov and ov:IsA("ValueBase") then
            local val = ov.Value
            if val ~= lp and val ~= lp.UserId and val ~= lp.Name then return true end
        end
        return false
    end

    local function isMine(v)
        local id = flightId and flightId:lower()
        if id and v.Name:lower() == id then return true end
        for _, key in ipairs(OWNER_KEYS) do
            local a = v:GetAttribute(key)
            if a ~= nil and (a == lp.UserId or a == lp.Name or tostring(a) == tostring(lp.UserId)) then return true end
        end
        local ov = v:FindFirstChild("Owner") or v:FindFirstChild("OwnerUserId")
        if ov and ov:IsA("ValueBase") and (ov.Value == lp or ov.Value == lp.UserId or ov.Value == lp.Name) then return true end
        return false
    end

    function findPlane()
        if planeCache and planeCache.Parent then return planeCache end
        planeCache = nil
        if os.clock() - lastPlaneScan < 0.3 then return nil end
        lastPlaneScan = os.clock()
        local best, bestD
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and not (lp.Character and v:IsDescendantOf(lp.Character)) then
                if isMine(v) then
                    planeCache = v
                    return v
                end
                if v.Name:lower():find("plane") and not ownedByOther(v) then
                    local si = spawnInfo[v]
                    if si and si.t >= throwStartT - 0.2 and si.d <= CFG.PlaneSpawnDist then
                        if not bestD or si.d < bestD then best, bestD = v, si.d end
                    end
                end
            end
        end
        if best then planeCache = best; log("[BAY] nhận máy bay của mình: " .. best:GetFullName()) end
        return best
    end
end

local function partFromPlane(p)
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
end

local function planeRoot()
    local p = findPlane()
    if not p then return root() end
    return partFromPlane(p) or root()
end

-- Cổng cuối
local GATE_KW = {"cổng", "cong", "gate", "finish", "goal", "đích", "dich", "portal", "ketthuc"}
local gates, gateOverride, curGate, gateChosen = {}, nil, nil, false

local function scanGates()
    gates = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = v.Name:lower()
            local pn = v.Parent and v.Parent.Name:lower() or ""
            for _, k in ipairs(GATE_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    gates[#gates + 1] = v
                    break
                end
            end
        end
    end
end

local function pickGate()
    if gateOverride and gates[gateOverride] and gates[gateOverride].Parent then
        return gates[gateOverride]
    end
    local r = planeRoot()
    if not r then return nil end
    local l = r.CFrame.LookVector
    local look = Vector3.new(l.X, 0, l.Z)
    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local best, bestD
    for _, g in ipairs(gates) do
        if g.Parent then
            local d = g.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 40 and flat.Magnitude < 20000 and flat.Unit:Dot(look) > 0.5 then
                if not bestD or flat.Magnitude > bestD then best, bestD = g, flat.Magnitude end
            end
        end
    end
    return best
end

-- Lực nâng + đẩy tiến
local thrustAtt, thrustForce
local function clearThrust()
    if thrustForce then thrustForce:Destroy(); thrustForce = nil end
    if thrustAtt then thrustAtt:Destroy(); thrustAtt = nil end
end
local function ensureThrust(r)
    if thrustForce and thrustForce.Parent and thrustAtt and thrustAtt.Parent == r then return end
    clearThrust()
    thrustAtt = new("Attachment", {Name = "HHubThrustAtt"}, r)
    thrustForce = new("VectorForce", {Name = "HHubThrust", Attachment0 = thrustAtt,
        RelativeTo = Enum.ActuatorRelativeTo.World, ApplyAtCenterOfMass = true, Force = Vector3.zero}, r)
end

-- Raycast kiểm tra vật cản (bỏ qua kẹo / coin / cổng / vật trong suốt)
local avoidParams = RaycastParams.new()
avoidParams.FilterType = Enum.RaycastFilterType.Exclude
avoidParams.IgnoreWater = true

local function refreshAvoidFilter()
    local list = {}
    if lp.Character then list[#list + 1] = lp.Character end
    if planeCache then list[#list + 1] = planeCache end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then list[#list + 1] = p.Character end
    end
    avoidParams.FilterDescendantsInstances = list
end

local blockingHit
do
    local IGN = {"candy", "kẹo", "lolli", "sweet", "sugar", "coin", "gate", "cổng", "finish"}
    local function isIgnoredName(i)
        local n = i.Name:lower()
        local pn = (i.Parent and i.Parent ~= workspace) and i.Parent.Name:lower() or ""
        for _, k in ipairs(IGN) do
            if n:find(k, 1, true) or pn:find(k, 1, true) then return true end
        end
        return false
    end
    function blockingHit(origin, vec)
        local res = workspace:Raycast(origin, vec, avoidParams)
        local i = res and res.Instance
        if i and i ~= curGate and i.Transparency < 0.95 and (i.CanCollide or i.CanTouch) and not isIgnoredName(i) then
            return res
        end
    end
end

local function pathBlocked(origin, dir, dist)
    local lat = Vector3.new(-dir.Z, 0, dir.X) * 5
    return blockingHit(origin, dir * dist) or blockingHit(origin + lat, dir * dist) or blockingHit(origin - lat, dir * dist)
end

