    local function pctOnly(t)
        t = (tostring(t):gsub("<[^>]->", ""))
        return t:match("^%s*%d+[%.,]?%d*%s*%%%s*$") ~= nil
    end

    local function newTracker()
        local T = {items = {}, ignored = setmetatable({}, {__mode = "k"}),
            base = setmetatable({}, {__mode = "k"}), lastScan = -10}
        local function isPctLabel(o)
            return (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text:find("%d%s*%%") ~= nil and visibleChain(o)
        end
        function T:snapshot()
            for _, o in ipairs(guiPool(true)) do
                if o.Parent and isPctLabel(o) then self.base[o] = o.Text end
            end
        end
        function T:scan(now)
            self.lastScan = now
            for _, o in ipairs(guiPool()) do
                if o.Parent and not self.items[o] and not self.ignored[o] and isPctLabel(o) then
                    if self.base[o] == nil or self.base[o] ~= o.Text then
                        self.items[o] = {v = readObj(o), born = now, n = 0, hist = {}, lo = 9, hi = -9, pure = pctOnly(o.Text)}
                    end
                end
            end
        end
        function T:update(now)
            for o, s in pairs(self.items) do
                if not o.Parent then
                    self.items[o] = nil
                else
                    local v = readObj(o)
                    if v then
                        if s.v and math.abs(v - s.v) > 1e-4 then
                            s.n += 1
                            s.tChange = now
                            local h = s.hist
                            h[#h + 1] = {now, v}
                            if #h > 12 then table.remove(h, 1) end
                        end
                        if v < s.lo then s.lo = v end
                        if v > s.hi then s.hi = v end
                        s.v = v
                    end
                    if not s.manual and s.n < 4 and now - (s.tChange or s.born) > 1.5 then
                        self.items[o] = nil
                        self.ignored[o] = true
                    end
                end
            end
        end
        function T:best()
            local bo, bs, bscore
            for o, s in pairs(self.items) do
                if s.n >= 1 or s.manual then
                    local range = (s.hi >= s.lo) and (s.hi - s.lo) or 0
                    local score = math.min(s.n, 30) + range * 40 + (s.pure and 8 or 0)
                        + (nameHas(o) and 3 or 0) + (s.manual and 100 or 0)
                    if not bscore or score > bscore then bo, bs, bscore = o, s, score end
                end
            end
            return bs, bo
        end
        return T
    end

    local function rateOf(s)
        local h = s.hist
        local n = #h
        if n < 2 then return 0 end
        local b = h[n]
        local a = b
        for i = n - 1, 1, -1 do
            if b[1] - h[i][1] > 0.18 then break end
            a = h[i]
        end
        local dt = b[1] - a[1]
        if dt < 0.03 then a = h[n - 1]; dt = b[1] - a[1] end
        if dt <= 0 then return 0 end
        return (b[2] - a[2]) / dt
    end

    local function dumpCand(T)
        local rows = {}
        for o, s in pairs(T.items) do
            if s.n >= 1 or s.manual then
                local ok = s.hi >= s.lo
                rows[#rows + 1] = ("%s.%s n=%d %.0f-%.0f%%"):format(o.Parent and o.Parent.Name or "?", o.Name,
                    s.n, (ok and s.lo or 0) * 100, (ok and s.hi or 0) * 100)
            end
        end
        table.sort(rows)
        return table.concat(rows, " | ", 1, math.min(#rows, 4))
    end

