-- ESP đỏ vật cản trong dải độ cao máy bay, chạy cả khi CHƯA ném (dùng BoxHandleAdornment, không dính giới hạn 31 Highlight)
local espBoxes = {}
local function espClear()
    for p, a in pairs(espBoxes) do pcall(function() a:Destroy() end) end
    table.clear(espBoxes)
end
local ESP_IGN = {"candy", "kẹo", "lolli", "sweet", "sugar", "coin", "gate", "cổng", "finish"}
local function espScan()
    local r = root()
    if not r then return end
    local ref = (inFlight and planeCache and partFromPlane(planeCache)) or r
    local origin = ref.Position
    local y = origin.Y + (inFlight and 0 or CFG.HoldHeight)
    local cand, n = {}, 0
    for i, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Anchored and v.CanCollide and v.Transparency < 0.95 and not v:IsA("Terrain") then
            local sz = v.Size
            if math.max(sz.X, sz.Y, sz.Z) >= 3
                and not (lp.Character and v:IsDescendantOf(lp.Character))
                and not (planeCache and v:IsDescendantOf(planeCache))
                and not (routeFolder and v:IsDescendantOf(routeFolder)) then
                local d = (v.Position - origin).Magnitude
                if d <= CFG.EspRange then
                    local cf = v.CFrame
                    local hy = math.abs(cf.RightVector.Y) * sz.X * 0.5 + math.abs(cf.UpVector.Y) * sz.Y * 0.5
                        + math.abs(cf.LookVector.Y) * sz.Z * 0.5
                    if v.Position.Y - hy <= y + CFG.EspBand and v.Position.Y + hy >= y - CFG.EspBand then
                        local nl = v.Name:lower()
                        local pl = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
                        local ign = false
                        for _, k in ipairs(ESP_IGN) do
                            if nl:find(k, 1, true) or pl:find(k, 1, true) then ign = true break end
                        end
                        if not ign then n += 1; cand[n] = {v, d} end
                    end
                end
            end
        end
        if i % 4000 == 0 then task.wait() end
    end
    table.sort(cand, function(a, b) return a[2] < b[2] end)
    local want = {}
    for i = 1, math.min(n, CFG.EspMax) do want[cand[i][1]] = true end
    for p, a in pairs(espBoxes) do
        if not want[p] or not p.Parent then pcall(function() a:Destroy() end); espBoxes[p] = nil end
    end
    for p in pairs(want) do
        if not espBoxes[p] then
            espBoxes[p] = new("BoxHandleAdornment", {Adornee = p, Size = p.Size, AlwaysOnTop = true, ZIndex = 1,
                Transparency = 0.55, Color3 = Color3.fromRGB(255, 40, 40)}, gui)
        end
    end
end
task.spawn(function()
    while State.Running do
        if CFG.ObsESP then pcall(espScan) else espClear() end
        task.wait(3)
    end
end)

