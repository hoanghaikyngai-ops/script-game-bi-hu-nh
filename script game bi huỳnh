bind(RunService.RenderStepped:Connect(function()
    local t = os.clock()
    grad.Rotation = (t * 140) % 360
    glowGrad.Rotation = (t * 140) % 360
    stripGrad.Offset = Vector2.new(((t * 0.6) % 2) - 1, 0)
    for i, d in ipairs(dots) do
        local b = (math.sin(t * 4 + i * 0.7) + 1) / 2
        d.BackgroundColor3 = Color3.fromHSV((t * 0.2 + i / 10) % 1, 1, 1)
        d.BackgroundTransparency = 0.75 - b * 0.75
    end
end))

task.spawn(function()
    while State.Running do
        pcall(function()
            status.Text = ("Ném: %d | Coin +%s | Vị trí: %s\nThanh lực: %s | Lực cuối: %s"):format(
                throws, tostring(getCoins() - startCoins),
                (zoneCache and zoneCache.Parent and "Khu vực phóng ✓") or (throwSpot and "đã lưu") or "chưa",
                (meterObj and meterObj.Parent) and ("✓ " .. meterObj.Name) or "chưa thấy",
                lastPower and string.format("%.0f%%", lastPower * 100) or "-")
            local pr = inFlight and planeRoot()
            local dist = ""
            if pr and curGate and curGate.Parent then
                local d = curGate.Position - pr.Position
                dist = (" | còn %d stud"):format(math.floor(Vector3.new(d.X, 0, d.Z).Magnitude))
            end
            flyInfo.Text = ("Cổng: %s (%d vật khớp)%s\nTrạng thái: %s"):format(
                curGate and curGate.Name or "chưa chọn", #gates, dist,
                reachedGate and "đã chạm cổng" or (inFlight and "đang bay" or "chờ ném"))
            farmInfo.Text = "Fam lực: " .. (CFG.FarmPower and farmStatus or "tắt") ..
                "\nChỗ fam: " .. ((farmCF and "đã lưu tay") or (farmPartCache and farmPartCache.Parent and "tự tìm ✓") or "chưa thấy")
            nowPlaying.Text = "♪ " .. Music.CurrentName .. (MusicSound.Playing and "  (đang phát)" or "  (tạm dừng)")
            local n, tail = #logs, {}
            for i = math.max(1, n - 11), n do tail[#tail + 1] = logs[i] end
            logLabel.Text = table.concat(tail, "\n")
        end)
        task.wait(1)
    end
end)

