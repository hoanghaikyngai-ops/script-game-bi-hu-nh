local findUnlocks
do
    local UNLOCK_KW = {"mở khóa", "mở khoá", "mo khoa", "unlock"}
    local SUF = {k = 1e3, m = 1e6, b = 1e9, t = 1e12}

    local function parseMult(s)
        s = tostring(s):lower()
        local best = 0
        local function consider(num, suf)
            local n = tonumber((tostring(num):gsub(",", ".")))
            if n then
                n = n * (SUF[suf or ""] or 1)
                if n > best then best = n end
            end
        end
        for num, a, b in s:gmatch("x%s*(%d+[%.,]?%d*)(%a?)(%a?)") do
            consider(num, (SUF[a] and b == "") and a or "")
        end
        for num, suf in s:gmatch("(%d+[%.,]?%d*)([kmbt]?)x") do consider(num, suf) end
        return best
    end

    local function collectTexts(root_)
        local t = {}
        for _, d in ipairs(root_:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then t[#t + 1] = d.Text
            elseif d:IsA("ProximityPrompt") then t[#t + 1] = d.ActionText .. " " .. d.ObjectText end
            if #t > 60 then break end
        end
        return table.concat(t, " ")
    end

    function findUnlocks()
        local res, seen = {}, {}
        local function add(key, u)
            if not key or seen[key] then return end
            seen[key] = true
            res[#res + 1] = u
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            local match, blob = false, ""
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                if hasKw(v.Text, UNLOCK_KW) or hasKw(v.Name, UNLOCK_KW) then match, blob = true, v.Text end
            elseif v:IsA("ProximityPrompt") then
                if hasKw(v.ActionText, UNLOCK_KW) or hasKw(v.ObjectText, UNLOCK_KW) or hasKw(v.Name, UNLOCK_KW) then
                    match, blob = true, v.ActionText .. " " .. v.ObjectText
                end
            elseif v:IsA("BasePart") or v:IsA("Model") then
                if hasKw(v.Name, UNLOCK_KW) then match = true end
            end
            if match then
                local part = partOf(v)
                if part then
                    local texts = {blob, v.Name, part.Name}
                    local lc = v:FindFirstAncestorWhichIsA("LayerCollector")
                    if lc then texts[#texts + 1] = collectTexts(lc) end
                    texts[#texts + 1] = collectTexts(part)
                    if v:IsA("Model") then texts[#texts + 1] = collectTexts(v) end
                    if part.Parent and part.Parent ~= workspace and part.Parent:IsA("Model") then
                        texts[#texts + 1] = part.Parent.Name
                        texts[#texts + 1] = collectTexts(part.Parent)
                    end
                    local mult = parseMult(table.concat(texts, " "))
                    if mult > 0 then add(part, {part = part, name = v.Name, mult = mult}) end
                end
            end
        end
        table.sort(res, function(a, b) return a.mult > b.mult end)
        return res
    end
end

local farmStatus, lastUnlockCheck, lastUnlockPart, lastUnlockMult = "tắt", 0, nil, 0

local function standingOn(part)
    local r = root()
    if not (r and part and part.Parent) then return false end
    local d = r.Position - part.Position
    local radius = math.max(10, math.max(part.Size.X, part.Size.Z) / 2 + 4)
    return Vector3.new(d.X, 0, d.Z).Magnitude <= radius and math.abs(d.Y) <= part.Size.Y / 2 + 14
end

local function unlockBest(force)
    local list = findUnlocks()
    local best = list[1]
    if not best then farmStatus = "không thấy khu Mở khóa"; return nil end
    if not force then
        for _, u in ipairs(list) do
            if u.mult < best.mult then break end
            if standingOn(u.part) then
                lastUnlockPart, lastUnlockMult = u.part, u.mult
                farmStatus = ("đang đứng khu cao nhất x%s"):format(abbr(u.mult))
