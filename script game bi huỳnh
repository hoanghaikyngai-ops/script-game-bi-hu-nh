-- Khu vực phóng (cache như HOANGHAI để khỏi quét workspace liên tục)
local ZONE_NAMES = {"khu vực phóng", "khu vuc phong", "launch area", "launch zone"}
local zoneCache

local function matchZone(s)
    s = tostring(s):lower()
    for _, n in ipairs(ZONE_NAMES) do
        if s:find(n, 1, true) then return true end
    end
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    local bb = inst:FindFirstAncestorWhichIsA("BillboardGui")
    if bb and bb.Adornee then return partOf(bb.Adornee) end
    local p = inst.Parent
    while p and p ~= workspace and p ~= game do
        if p:IsA("BasePart") then return p end
        if p:IsA("Model") then
            local bp = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
            if bp then return bp end
        end
        p = p.Parent
    end
end

local lastZoneScan = 0
local function findZone()
    if zoneCache and zoneCache.Parent then return zoneCache end
    if os.clock() - lastZoneScan < 2 then return nil end -- không quét mỗi frame
    lastZoneScan = os.clock()
    for _, v in ipairs(workspace:GetDescendants()) do
        local hit = matchZone(v.Name)
        if not hit and (v:IsA("TextLabel") or v:IsA("TextButton")) then hit = matchZone(v.Text) end
        if hit then
            local p = partOf(v)
            if p then zoneCache = p; return p end
        end
    end
end

local function getThrowCFrame()
    local z = findZone()
    if z then return z.CFrame + Vector3.new(0, z.Size.Y / 2 + 3, 0) end
    return throwSpot
end

-- Máy bay đang bay
local inFlight, baseY, planeCache, reachedGate = false, nil, nil, false
local lastPlaneScan = 0

local function findPlane()
    if planeCache and planeCache.Parent then return planeCache end
    if os.clock() - lastPlaneScan < 0.4 then return nil end -- throttle: trước đây quét mỗi frame
    lastPlaneScan = os.clock()
    local id = flightId and flightId:lower()
    local r = root()
    local best, bestD
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart")) and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = v.Name:lower()
            local owner = v:GetAttribute("OwnerUserId") or v:GetAttribute("Owner") or v:GetAttribute("UserId")
            if (id and n == id) or owner == lp.UserId or owner == lp.Name then
                planeCache = v; return v
            end
            if r and n:find("plane") then
                local part = v:IsA("BasePart") and v or v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (part.Position - r.Position).Magnitude
                    if d < 150 and (not bestD or d < bestD) then best, bestD = v, d end
                end
            end
        end
    end
    if best then planeCache = best end
    return best
end

local function planeRoot()
    local p = findPlane()
    if not p then return root() end
    if p:IsA("BasePart") then return p end
    return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) or root()
end

-- Cổng cuối
local GATE_KW = {"cổng", "cong", "gate", "finish", "goal", "đích", "dich", "portal", "ketthuc"}
local gates, gateOverride, curGate, gateChosen = {}, nil, nil, false

local function scanGates()
    gates = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = v.Name:lower()
            local pn = v.Parent and v.Parent.Name:lower() or ""
            for _, k in ipairs(GATE_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    gates[#gates + 1] = v
                    break
                end
            end
        end
    end
end

local function pickGate()
    if gateOverride and gates[gateOverride] and gates[gateOverride].Parent then
        return gates[gateOverride]
    end
    local r = planeRoot()
    if not r then return nil end
    local l = r.CFrame.LookVector
    local look = Vector3.new(l.X, 0, l.Z)
    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local best, bestD
    for _, g in ipairs(gates) do
        if g.Parent then
            local d = g.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 40 and flat.Magnitude < 20000 and flat.Unit:Dot(look) > 0.5 then
                if not bestD or flat.Magnitude > bestD then best, bestD = g, flat.Magnitude end
            end
        end
    end
    return best
end

-- Lực đẩy
local thrustAtt, thrustForce
local function clearThrust()
    if thrustForce then thrustForce:Destroy(); thrustForce = nil end
    if thrustAtt then thrustAtt:Destroy(); thrustAtt = nil end
end
local function ensureThrust(r)
    if thrustForce and thrustForce.Parent and thrustAtt and thrustAtt.Parent == r then return end
    clearThrust()
    thrustAtt = new("Attachment", {Name = "HHubThrustAtt"}, r)
    thrustForce = new("VectorForce", {Name = "HHubThrust", Attachment0 = thrustAtt,
        RelativeTo = Enum.ActuatorRelativeTo.World, ApplyAtCenterOfMass = true, Force = Vector3.zero}, r)
end

bind(RunService.Heartbeat:Connect(function()
    if not (CFG.KeepFlying and inFlight and not reachedGate) then
        if thrustForce then clearThrust() end
        return
    end
    local r = planeRoot()
    if not r or r.Anchored then return end
    ensureThrust(r)
    baseY = baseY or r.Position.Y
    if not gateChosen then gateChosen = true; curGate = pickGate() end

    local pos = r.Position
    local dir
    if curGate and curGate.Parent then
        local d = curGate.Position - pos
        dir = Vector3.new(d.X, 0, d.Z)
        if dir.Magnitude <= GATE_STOP + curGate.Size.Magnitude / 4 then
            reachedGate = true
            clearThrust()
            if firetouchinterest then
                pcall(function() firetouchinterest(r, curGate, 0); firetouchinterest(r, curGate, 1) end)
            end
            notify("Cổng", "Đã chạm cổng cuối")
            return
        end
    end
    if not dir or dir.Magnitude < 0.1 then
        local l = r.CFrame.LookVector
        dir = Vector3.new(l.X, 0, l.Z)
    end
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
    dir = dir.Unit

    local mass = r.AssemblyMass
    local g = workspace.Gravity
    local up = g + math.clamp((baseY + CFG.HoldHeight - pos.Y) * 6, -g * 0.8, CFG.Lift)
    local vel = r.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local along = hv:Dot(dir)
    local push = along < CFG.FlySpeed and CFG.Push or 0
    local lateral = hv - dir * along
    local f = Vector3.new(dir.X * push, up, dir.Z * push) - Vector3.new(lateral.X, 0, lateral.Z) * 3
    thrustForce.Force = f * mass
    r.AssemblyAngularVelocity = Vector3.zero
end))

-- Một lượt ném: tele -> giữ -> thả MAX lực -> bay đến cổng
local function throwOnce()
    local cf = getThrowCFrame()
    if cf and root() then
        root().CFrame = cf
        task.wait(0.3)
    end
    if #gates == 0 then scanGates() end
    flightId, ended = nil, false
    planeCache, baseY, curGate, gateChosen, reachedGate = nil, nil, nil, false, false
    Remote:FireServer("ChargeBegin", throwId)
    task.wait(CFG.ChargeHold)
    Remote:FireServer("ChargeRelease", throwId, POWER_MAX, nil)
    throws += 1
    inFlight = true
    local t0 = os.clock()
    while State.Running and CFG.AutoThrow and not ended and not reachedGate and os.clock() - t0 < CFG.MaxFlight do
        if flightId then Remote:FireServer("Steer", flightId, 0, CFG.SteerY) end
        task.wait(CFG.SteerRate)
    end
    if reachedGate then
        local t1 = os.clock()
        while State.Running and not ended and os.clock() - t1 < 6 do task.wait(0.1) end
    end
end

task.spawn(function()
    while State.Running do
        task.wait(0.2)
        if CFG.AutoThrow and throwId then
            -- pcall: lỗi 1 lượt không làm chết cả vòng lặp
            local ok, err = pcall(throwOnce)
            if not ok then log("[LOI] " .. tostring(err)) end
            inFlight = false
            clearThrust()
            task.wait(CFG.Between)
        end
    end
end)

