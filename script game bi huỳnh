local function row3(page, items)
    local f = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1}, page)
    new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6)}, f)
    for _, it in ipairs(items) do
        local b = new("TextButton", {Size = UDim2.new(1 / #items, -6, 1, 0), BackgroundColor3 = Color3.fromRGB(55, 85, 160),
            Text = it[1], TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 14}, f)
        new("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
        b.MouseButton1Click:Connect(it[2])
    end
end
