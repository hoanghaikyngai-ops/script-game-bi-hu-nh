-- VÒNG ĐIỀU KHIỂN MÁY BAY MỖI KHUNG HÌNH
------------------------------------------------------------------
local function flightStep()
    if not (inFlight and not reachedGate) then
        if Rig.active then clearThrust() end
        if steerState ~= 0 then setSteer(0) end
        State.pr = nil
        return
    end
    local pl = findPlane()
    local r = pl and partFromPlane(pl)
    if not r or r == root() then return end        -- chưa nhận ra máy bay: tuyệt đối không điều khiển nhân vật
    local now = os.clock()
    local dt = now - (State.lastStep or now)
    State.lastStep = now
    baseY = baseY or r.Position.Y

    local fin = finalPos()
    if not gateChosen then
        gateChosen = true
        if fin then curGate = nearestGateTo(fin, 250) else curGate = pickGate() end
    end

    local pos = r.Position
    local vel = r.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local speed = hv.Magnitude
    local dir
    if speed > 3 then
        dir = hv.Unit
    else
        local l = r.CFrame.LookVector
        dir = Vector3.new(l.X, 0, l.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
        dir = dir.Unit
    end
    State.pr, State.dir = r, dir

    -- điểm lộ trình / tọa độ phụ
    local wp = wpTarget()
    if wp then
        local d = wp - pos
        local flat = Vector3.new(d.X, 0, d.Z)
        State.wpDist = flat.Magnitude
        if CFG.UseRoute and Route.idx <= #Route.pts then
            local passed = flat.Magnitude > 0.1 and flat.Unit:Dot(dir) < -0.2
            if State.wpDist <= CFG.RouteRadius or (passed and State.wpDist < CFG.RouteRadius * 3) then
                log(("[ROUTE] qua điểm %d/%d"):format(Route.idx, #Route.pts))
                Route.idx += 1
                wp = wpTarget()
            end
        elseif State.wpDist <= CFG.WpRadius then
            reachedGate = true
            clearThrust(); setSteer(0)
            notify("Tọa độ", "Đã tới tọa độ đã đặt")
            return
        end
    else
        State.wpDist = nil
    end

    -- ĐÍCH CUỐI
    if fin then
        local d = fin - pos
        local flat = Vector3.new(d.X, 0, d.Z)
        State.finDist = flat.Magnitude
        State.finStart = State.finStart or math.max(flat.Magnitude, 1)
        if flat.Magnitude <= CFG.FinalRadius then
            reachedGate = true
            clearThrust(); setSteer(0)
            if curGate and curGate.Parent and firetouchinterest then
                pcall(function() firetouchinterest(r, curGate, 0); firetouchinterest(r, curGate, 1) end)
            end
            notify("Đích", "Đã tới đích cuối")
            return
        end
    elseif curGate and curGate.Parent then
        local d = curGate.Position - pos
        if Vector3.new(d.X, 0, d.Z).Magnitude <= 30 + curGate.Size.Magnitude / 4 then
            reachedGate = true
            clearThrust(); setSteer(0)
            if firetouchinterest then
                pcall(function() firetouchinterest(r, curGate, 0); firetouchinterest(r, curGate, 1) end)
            end
            notify("Cổng", "Đã chạm cổng cuối")
            return
        end
    end

    local flying = CFG.KeepFlying and not r.Anchored

    if now - (State.lastFilter or 0) > 0.25 then
        State.lastFilter = now
        refreshAvoidFilter()
    end
    local sp = math.max(speed, State.actual or 0)
    local d = updateDodge(pos, dir, sp, r)

    local c = 0
    local tgt = wp or fin or ((CFG.SteerGate and curGate and curGate.Parent) and curGate.Position or nil)
    if d == 0 then
        if wp then
            c = updateWaypoint(pos, dir, wp)
        else
            c = updateCandy(pos, dir)
            if c == 0 and tgt then c = updateWaypoint(pos, dir, tgt) end
        end
    end
    if c == -1 and DG.vetoL then c = 0 elseif c == 1 and DG.vetoR then c = 0 end
    setSteer(d ~= 0 and d or c)

    if flying then
        Rig.ensure(r)
        local g = workspace.Gravity
        local cruiseY = baseY + CFG.HoldHeight
        local holdY = cruiseY
        if wp and CFG.WpFollowY then
            holdY = wp.Y
        elseif fin and CFG.FinalFollowY and State.finStart and State.finDist then
            local prog = 1 - math.clamp(State.finDist / State.finStart, 0, 1)
            holdY = cruiseY + (fin.Y - cruiseY) * prog
        end
        local wantY = holdY + (DG.climb == 1 and 60 or 0)

        local _, minY = Rig.ground(pos, dir, speed, r)
        local guard = false
        if minY then
            if minY > wantY then wantY = minY end
            guard = pos.Y < minY + 1
        end
        Rig.climbCmd = guard and 1 or 0

        local vy = CFG.SmoothAlt and vel.Y or 0
        local upMax = guard and math.max(CFG.Lift, CFG.GroundLift) or CFG.Lift
        local up = g + math.clamp((wantY - pos.Y) * 6 - vy * 2.5, -g * 0.85, upMax)

        local push = (CFG.MaxForce or speed < CFG.FlySpeed) and CFG.Push or 0
        if CFG.RigBoost > 0 and speed < CFG.RigMaxSpeed then push += CFG.RigBoost end

        local turn = 0
        if CFG.RigSide then
            if d ~= 0 then turn = d * CFG.RigDodgeTurn
            elseif CFG.RigSteer and c ~= 0 then turn = c * CFG.RigTurn end
        end

        Rig.apply(r, dir, push, up, turn, speed)
        if Rig.floorGuard(r, pos, vel) then State.floorHits = (State.floorHits or 0) + 1 end
    elseif Rig.active then
        clearThrust()
    end

    if d ~= 0 and CFG.DodgeAssist and DG.lat > 1 and not r.Anchored then
        local side = Vector3.new(-dir.Z, 0, dir.X)
        r.CFrame = r.CFrame + side * d * DG.lat * dt
    end
end
bind(RunService.Heartbeat:Connect(function()
    local ok, err = pcall(flightStep)
    if not ok and State.lastErr ~= tostring(err) then
        State.lastErr = tostring(err)
        log("[LOI bay] " .. State.lastErr)
    end
end))

