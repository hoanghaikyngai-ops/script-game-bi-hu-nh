local function rejoin()
    notify("Rejoin", "Đang vào lại server...")
    task.spawn(function()
        pcall(function()
            if #Players:GetPlayers() <= 1 then TeleportService:Teleport(game.PlaceId, lp)
            else TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp) end
        end)
    end)
end

local function hopLow()
    notify("Server Hop", "Đang tìm server ít người...")
    task.spawn(function()
        local ok, body = pcall(function()
            return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        end)
        local best
        if ok then
            local d = select(2, pcall(HttpService.JSONDecode, HttpService, body))
            for _, s in ipairs(type(d) == "table" and d.data or {}) do
                if s.id ~= game.JobId and (s.playing or 0) > 0 and (s.playing or 0) < (s.maxPlayers or 0) then
                    if not best or s.playing < best.playing then best = s end
                end
            end
        end
        if best then
            notify("Server Hop", "Vào server " .. best.playing .. " người")
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, lp) end)
        else
            notify("Server Hop", "Không tìm thấy server phù hợp")
        end
    end)
end

