local UNLOCK_KW = {"mở khóa", "mở khoá", "mo khoa", "unlock"}
local FARM_KW = {"fam lực", "farm lực", "fam luc", "farm luc", "farm power", "power farm", "luyện lực", "luyen luc", "tập lực", "fam sức", "farm sức"}
local SUF = {k = 1e3, m = 1e6, b = 1e9, t = 1e12}

local function parseMult(s)
    s = tostring(s):lower()
    local best = 0
    local function consider(num, suf)
        local n = tonumber((tostring(num):gsub(",", ".")))
        if n then
            n = n * (SUF[suf or ""] or 1)
            if n > best then best = n end
        end
    end
    for num, a, b in s:gmatch("x%s*(%d+[%.,]?%d*)(%a?)(%a?)") do
        consider(num, (SUF[a] and b == "") and a or "")
    end
    for num, suf in s:gmatch("(%d+[%.,]?%d*)([kmbt]?)x") do consider(num, suf) end
    return best
end

local function collectTexts(root_)
    local t = {}
    for _, d in ipairs(root_:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then t[#t + 1] = d.Text
        elseif d:IsA("ProximityPrompt") then t[#t + 1] = d.ActionText .. " " .. d.ObjectText end
        if #t > 60 then break end
    end
    return table.concat(t, " ")
end

local function findUnlocks()
    local res, seen = {}, {}
    local function add(key, u)
        if not key or seen[key] then return end
        seen[key] = true
        res[#res + 1] = u
    end
    -- trong thế giới (bảng chữ, prompt, tên vật thể)
    for _, v in ipairs(workspace:GetDescendants()) do
        local match, blob = false, ""
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            if hasKw(v.Text, UNLOCK_KW) or hasKw(v.Name, UNLOCK_KW) then match, blob = true, v.Text end
        elseif v:IsA("ProximityPrompt") then
            if hasKw(v.ActionText, UNLOCK_KW) or hasKw(v.ObjectText, UNLOCK_KW) or hasKw(v.Name, UNLOCK_KW) then
                match, blob = true, v.ActionText .. " " .. v.ObjectText
            end
        elseif v:IsA("BasePart") or v:IsA("Model") then
            if hasKw(v.Name, UNLOCK_KW) then match = true end
        end
        if match then
            local part = partOf(v)
            if part then
                local texts = {blob, v.Name, part.Name}
                local lc = v:FindFirstAncestorWhichIsA("LayerCollector")
                if lc then texts[#texts + 1] = collectTexts(lc) end
                texts[#texts + 1] = collectTexts(part)
                if part.Parent and part.Parent ~= workspace and part.Parent:IsA("Model") then texts[#texts + 1] = part.Parent.Name end
                add(part, {part = part, name = v.Name, mult = parseMult(table.concat(texts, " "))})
            end
        end
    end
    -- trong giao diện (nút Mở khóa trên màn hình)
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, v in ipairs(pg:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton")) and hasKw(v.Text, UNLOCK_KW) and visibleChain(v) then
                local btn = v:IsA("GuiButton") and v or v:FindFirstAncestorWhichIsA("GuiButton")
                if btn then
                    local blob = v.Text .. " " .. collectTexts(btn) .. " " .. btn.Name
                    add(btn, {btn = btn, name = btn.Name, mult = parseMult(blob)})
                end
            end
        end
    end
    table.sort(res, function(a, b) return a.mult > b.mult end)
    return res
end

local function triggerUnlock(u)
    if u.btn then
        local b = u.btn
        local fired = false
        if type(getconnections) == "function" then
            for _, ev in ipairs({b.MouseButton1Click, b.Activated, b.MouseButton1Down}) do
                pcall(function()
                    for _, c in ipairs(getconnections(ev)) do c:Fire() fired = true end
                end)
            end
        end
        if not fired then
            local inset = GuiService:GetGuiInset()
            local x = b.AbsolutePosition.X + b.AbsoluteSize.X / 2
            local y = b.AbsolutePosition.Y + b.AbsoluteSize.Y / 2 + inset.Y
            pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
            mouseBtn(x, y, true); task.wait(0.05); mouseBtn(x, y, false)
        end
        return
    end
    local part, r = u.part, root()
    if not part then return end
    if r then r.CFrame = part.CFrame + Vector3.new(0, part.Size.Y / 2 + 3, 0) end
    task.wait(0.25)
    if firetouchinterest and r then
        pcall(function() firetouchinterest(r, part, 0); firetouchinterest(r, part, 1) end)
    end
    local scopes = {part}
    if part.Parent and part.Parent ~= workspace then scopes[#scopes + 1] = part.Parent end
    for _, sc in ipairs(scopes) do
        for _, d in ipairs(sc:GetDescendants()) do
            if d:IsA("ProximityPrompt") and fireproximityprompt then
                pcall(function() d.HoldDuration = 0; fireproximityprompt(d) end)
            elseif d:IsA("ClickDetector") and fireclickdetector then
                pcall(function() fireclickdetector(d) end)
            end
        end
    end
end

