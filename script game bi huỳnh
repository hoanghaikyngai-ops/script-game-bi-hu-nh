    local obj = {}
    function obj:Set(v)
        CFG[key] = v and true or false
        refresh(); saveCfg()
        if onChange then onChange(CFG[key]) end
    end
    b.MouseButton1Click:Connect(function()
        if key == "AutoThrow" and not CFG[key] and not throwId then
            return notify("Auto Ném", "Hãy ném tay 1 lần để lấy mã ném")
        end
        obj:Set(not CFG[key])
    end)
    refresh()
    -- áp dụng giá trị đã lưu từ lần trước
    if onChange and CFG[key] then task.defer(onChange, true) end
    return obj
end

