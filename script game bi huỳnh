local function button(page, text, fn, color)
    local b = new("TextButton", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = color or Color3.fromRGB(55, 85, 160),
        Text = text, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham, TextSize = 13}, page)
    new("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
    b.MouseButton1Click:Connect(function() fn(b) end)
