    button(pDest, "🔁 Chọn cổng khác làm đích", function()
        if #gates == 0 then scanGates() end
        if #gates == 0 then return notify("Cổng", "Không quét thấy cổng nào") end
        local r = root()
        if gateIdx == 0 and r then
