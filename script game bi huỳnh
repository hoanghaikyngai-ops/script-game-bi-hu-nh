bind(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.LeftControl then
        main.Visible = not main.Visible
        return
    end
    if CFG.DisableKeybinds then return end
    if input.KeyCode == Enum.KeyCode.F then flyToggle:Set(not CFG.PFly)
    elseif input.KeyCode == Enum.KeyCode.J then noclipToggle:Set(not CFG.Noclip)
    elseif input.KeyCode == Enum.KeyCode.L then
        local cnt = 0
        for _, o in ipairs(guiPool(true)) do
            if o.Parent and o.Text:find("%d%s*%%") then
                cnt += 1
                if cnt <= 25 then
                    log(("[%%] %s | %q | hiện=%s"):format(o:GetFullName(), o.Text, tostring(visibleChain(o))))
                end
            end
        end
        notify("Nhãn %", cnt .. " nhãn có %, xem tab Log")
    elseif input.KeyCode == Enum.KeyCode.K then
        if State.throwToggle then State.throwToggle:Set(not CFG.AutoThrow) end
    end
end))

