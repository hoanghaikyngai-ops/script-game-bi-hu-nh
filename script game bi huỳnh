local inFlight, baseY, planeCache, reachedGate = false, nil, nil, false
local flightStart = 0
local lastPlaneScan = 0

local function findPlane()
    if planeCache and planeCache.Parent then return planeCache end
    if os.clock() - lastPlaneScan < 0.4 then return nil end
    lastPlaneScan = os.clock()
    local id = flightId and flightId:lower()
    local r = root()
    local best, bestD
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart")) and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = v.Name:lower()
            local owner = v:GetAttribute("OwnerUserId") or v:GetAttribute("Owner") or v:GetAttribute("UserId")
            if (id and n == id) or owner == lp.UserId or owner == lp.Name then
                planeCache = v; return v
            end
            if r and n:find("plane") then
                local part = v:IsA("BasePart") and v or v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (part.Position - r.Position).Magnitude
                    if d < 150 and (not bestD or d < bestD) then best, bestD = v, d end
                end
            end
        end
    end
    if best then planeCache = best end
    return best
end

local function partFromPlane(p)
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
end

local function planeRoot()
    local p = findPlane()
    if not p then return root() end
    return partFromPlane(p) or root()
end

-- Dịch chuyển máy bay (giữ nguyên vận tốc)
local function moveFlight(delta, noFall)
    local p = planeCache
    local part = partFromPlane(p) or root()
    if not part then return end
    local vel = part.AssemblyLinearVelocity
    if p and p.Parent and p:IsA("Model") then
        p:PivotTo(p:GetPivot() + delta)
    else
        part.CFrame = part.CFrame + delta
    end
    part.AssemblyLinearVelocity = noFall and Vector3.new(vel.X, math.max(vel.Y, 0), vel.Z) or vel
end

-- Cổng cuối
local GATE_KW = {"cổng", "cong", "gate", "finish", "goal", "đích", "dich", "portal", "ketthuc"}
local gates, gateOverride, curGate, gateChosen = {}, nil, nil, false

local function scanGates()
    gates = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = v.Name:lower()
            local pn = v.Parent and v.Parent.Name:lower() or ""
            for _, k in ipairs(GATE_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    gates[#gates + 1] = v
                    break
                end
            end
        end
    end
end

local function pickGate()
    if gateOverride and gates[gateOverride] and gates[gateOverride].Parent then
        return gates[gateOverride]
    end
    local r = planeRoot()
    if not r then return nil end
    local l = r.CFrame.LookVector
    local look = Vector3.new(l.X, 0, l.Z)
    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local best, bestD
    for _, g in ipairs(gates) do
        if g.Parent then
            local d = g.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 40 and flat.Magnitude < 20000 and flat.Unit:Dot(look) > 0.5 then
                if not bestD or flat.Magnitude > bestD then best, bestD = g, flat.Magnitude end
            end
        end
    end
    return best
end

-- Lực đẩy
local thrustAtt, thrustForce
local function clearThrust()
    if thrustForce then thrustForce:Destroy(); thrustForce = nil end
    if thrustAtt then thrustAtt:Destroy(); thrustAtt = nil end
end
local function ensureThrust(r)
    if thrustForce and thrustForce.Parent and thrustAtt and thrustAtt.Parent == r then return end
    clearThrust()
    thrustAtt = new("Attachment", {Name = "HHubThrustAtt"}, r)
    thrustForce = new("VectorForce", {Name = "HHubThrust", Attachment0 = thrustAtt,
        RelativeTo = Enum.ActuatorRelativeTo.World, ApplyAtCenterOfMass = true, Force = Vector3.zero}, r)
end

-- Raycast kiểm tra vật cản
local avoidParams = RaycastParams.new()
avoidParams.FilterType = Enum.RaycastFilterType.Exclude
avoidParams.IgnoreWater = true

local function refreshAvoidFilter()
    local list = {}
    if lp.Character then list[#list + 1] = lp.Character end
    if planeCache then list[#list + 1] = planeCache end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then list[#list + 1] = p.Character end
    end
    avoidParams.FilterDescendantsInstances = list
end

local function blockingHit(origin, vec)
    local res = workspace:Raycast(origin, vec, avoidParams)
    if res and res.Instance and res.Instance.CanCollide and res.Instance ~= curGate then
        return res
    end
end

local function pathBlocked(origin, dir, dist)
    local lat = Vector3.new(-dir.Z, 0, dir.X) * 5
    return blockingHit(origin, dir * dist) or blockingHit(origin + lat, dir * dist) or blockingHit(origin - lat, dir * dist)
end

-- 1) NÉ VẬT CẢN BẰNG TELE TRÁI / PHẢI
local lastDodge = 0
local function dodge(pos, dir, along)
    if not CFG.AvoidObstacles then return end
    local now = os.clock()
    if now - lastDodge < 0.35 then return end
    local look = math.max(CFG.AvoidDist, along * 0.4)
    if not pathBlocked(pos, dir, look) then return end
    lastDodge = now
    local side = Vector3.new(-dir.Z, 0, dir.X)
    local order = (math.random() < 0.5) and {side, -side} or {-side, side}
    for _, mult in ipairs({1, 2, 3}) do
        local off = CFG.DodgeSide * mult
        for _, s in ipairs(order) do
            local target = pos + s * off
            if not blockingHit(pos, s * off) and not pathBlocked(target, dir, look + 20) then
                moveFlight(s * off)
                log(("[NÉ] tele %s %d stud"):format(s == side and "phải" or "trái", off))
                return
            end
        end
    end
    moveFlight(Vector3.new(0, CFG.AvoidLift, 0))
    log("[NÉ] hai bên đều kín -> tele lên cao")
end

-- 2) GẦN CHẠM ĐẤT -> TELE LÊN LẠI ĐỘ CAO BAN ĐẦU
local lastRescue = 0
local function rescue(pos)
    if not CFG.AutoRescue then return end
    local now = os.clock()
    if now - flightStart < 1.5 or now - lastRescue < 0.5 then return end
    local hit = blockingHit(pos, Vector3.new(0, -CFG.RescueDist, 0))
    if not hit then return end
    local targetY = math.max((baseY or pos.Y) + CFG.HoldHeight, hit.Position.Y + 30)
    if targetY - pos.Y < 3 then return end
    lastRescue = now
    moveFlight(Vector3.new(0, targetY - pos.Y, 0), true)
    log(("[ĐÁP ĐẤT] tele lên độ cao %d"):format(targetY))
end

-- 3) TELE SANG TRÁI / PHẢI NHẶT KẸO
local CANDY_KW = {"candy", "kẹo", "lolli", "sweet", "sugar"}
local candyList, lastCandyScan, lastCandy = {}, 0, 0
local visited = setmetatable({}, {__mode = "k"})

local function scanCandy()
    lastCandyScan = os.clock()
    local list = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character))
            and not (planeCache and v:IsDescendantOf(planeCache)) then
            local n = v.Name:lower()
            local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
            for _, k in ipairs(CANDY_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    list[#list + 1] = v
                    break
                end
            end
            if #list >= 500 then break end
        end
    end
    candyList = list
end

local function candyStep(pos, dir)
    if not CFG.AutoCandy then return end
    local now = os.clock()
    if now - lastCandy < 0.3 then return end
    if now - lastCandyScan > 2 then scanCandy() end
    local best, bestScore
    for i = #candyList, 1, -1 do
        local c = candyList[i]
        if not c.Parent then
            table.remove(candyList, i)
        elseif not (visited[c] and now - visited[c] < 3) then
            local d = c.Position - pos
            local ahead = d.X * dir.X + d.Z * dir.Z
            local lat = math.abs(d.X * (-dir.Z) + d.Z * dir.X)
            if ahead > -15 and ahead < CFG.CandyAhead and lat <= CFG.CandyLateral and math.abs(d.Y) < 120 then
                local score = ahead + lat * 0.5
                if not bestScore or score < bestScore then best, bestScore = c, score end
            end
        end
    end
    if best then
        lastCandy = now
        visited[best] = now
        moveFlight(best.Position - pos)
        local pr = planeRoot()
        if firetouchinterest and pr then
            pcall(function() firetouchinterest(pr, best, 0); firetouchinterest(pr, best, 1) end)
        end
        log("[KẸO] tele nhặt " .. best.Name)
    end
end

bind(RunService.Heartbeat:Connect(function()
    if not (CFG.KeepFlying and inFlight and not reachedGate) then
        if thrustForce then clearThrust() end
        return
    end
    local r = planeRoot()
    if not r or r.Anchored then return end
    ensureThrust(r)
    baseY = baseY or r.Position.Y
    if not gateChosen then gateChosen = true; curGate = pickGate() end

    local pos = r.Position
    local dir
    if curGate and curGate.Parent then
        local d = curGate.Position - pos
        dir = Vector3.new(d.X, 0, d.Z)
        if dir.Magnitude <= GATE_STOP + curGate.Size.Magnitude / 4 then
            reachedGate = true
            clearThrust()
            if firetouchinterest then
                pcall(function() firetouchinterest(r, curGate, 0); firetouchinterest(r, curGate, 1) end)
            end
            notify("Cổng", "Đã chạm cổng cuối")
            return
        end
    end
    if not dir or dir.Magnitude < 0.1 then
        local l = r.CFrame.LookVector
        dir = Vector3.new(l.X, 0, l.Z)
    end
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
    dir = dir.Unit

    local mass = r.AssemblyMass
    local g = workspace.Gravity
    local up = g + math.clamp((baseY + CFG.HoldHeight - pos.Y) * 6, -g * 0.8, CFG.Lift)
    local vel = r.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local along = hv:Dot(dir)
    local push = along < CFG.FlySpeed and CFG.Push or 0
    local lateral = hv - dir * along
    local f = Vector3.new(dir.X * push, up, dir.Z * push) - Vector3.new(lateral.X, 0, lateral.Z) * 3

    thrustForce.Force = f * mass
    r.AssemblyAngularVelocity = Vector3.zero

    -- hỗ trợ: đáp đất -> né vật cản -> nhặt kẹo
    refreshAvoidFilter()
    rescue(pos)
    dodge(pos, dir, along)
    candyStep(pos, dir)
end))

