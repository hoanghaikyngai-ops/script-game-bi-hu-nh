local flyConn
local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local h, r = humanoid(), root()
    if h then h.PlatformStand = false end
    if r then
        for _, v in ipairs(r:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
        end
    end
end
local function startFly()
    stopFly()
    local r, h = root(), humanoid()
    if not r or not h then return end
    h.PlatformStand = true
    local bv = new("BodyVelocity", {MaxForce = Vector3.new(9e9, 9e9, 9e9), Velocity = Vector3.zero}, r)
    local bg = new("BodyGyro", {MaxTorque = Vector3.new(9e9, 9e9, 9e9), P = 1e7, D = 12000, CFrame = r.CFrame}, r)
    flyConn = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        local mv = Vector3.zero
        local md = h.MoveDirection
        if md.Magnitude > 0 then
            local lk = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            local rt = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
            if lk.Magnitude > 0.01 and rt.Magnitude > 0.01 then
                mv = cam.CFrame.LookVector * md:Dot(lk.Unit) + cam.CFrame.RightVector * md:Dot(rt.Unit)
            end
        end
        if mv.Magnitude > 0 then mv = mv.Unit end
        bv.Velocity = mv * CFG.PFlySpeed * 50
        bg.CFrame = CFrame.lookAt(r.Position, r.Position + cam.CFrame.LookVector)
    end)
end

