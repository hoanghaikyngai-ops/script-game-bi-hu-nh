-- Raycast kiểm tra vật cản (bỏ qua kẹo / coin / cổng / vật trong suốt)
local avoidParams = RaycastParams.new()
avoidParams.FilterType = Enum.RaycastFilterType.Exclude
avoidParams.IgnoreWater = true
local DG = {dir = 0, untilT = 0, lat = 0, ahead = nil, climb = 0, lastScan = 0, base = {}}

local function refreshAvoidFilter()
    local list = {}
    if lp.Character then list[#list + 1] = lp.Character end
    if planeCache then list[#list + 1] = planeCache end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then list[#list + 1] = p.Character end
    end
    DG.base = list
    avoidParams.FilterDescendantsInstances = list
end

local blockingHit, updateDodge
do
    local IGN = {"candy", "kẹo", "lolli", "sweet", "sugar", "coin", "gate", "cổng", "finish"}
    local function isIgnoredName(i)
        local n = i.Name:lower()
        local pn = (i.Parent and i.Parent ~= workspace) and i.Parent.Name:lower() or ""
        for _, k in ipairs(IGN) do
            if n:find(k, 1, true) or pn:find(k, 1, true) then return true end
        end
        return false
    end

    local function cast(origin, vec, radius)
        if radius and radius > 0.5 then
            local ok, res = pcall(function() return workspace:Spherecast(origin, radius, vec, avoidParams) end)
            if ok then
                if res and res.Distance < 1.5 and res.Normal.Y > 0.5 then
                    return workspace:Raycast(origin, vec, avoidParams) -- đang sát sàn: chỉ dùng tia mảnh
                end
                return res
            end
        end
        return workspace:Raycast(origin, vec, avoidParams)
    end

    -- trả về kết quả cast đầu tiên là vật chắn THẬT (bỏ qua kẹo/coin/cổng/trong suốt rồi cast tiếp)
    function blockingHit(origin, vec, radius)
        local filt
        for _ = 1, 4 do
            local res = cast(origin, vec, radius)
            if not res then break end
            local i = res.Instance
            local ghost = (not i:IsA("Terrain")) and
                (i == curGate or i.Transparency >= 0.95 or not (i.CanCollide or i.CanTouch) or isIgnoredName(i))
            if not ghost then
                if filt then avoidParams.FilterDescendantsInstances = DG.base end
                return res
            end
            filt = filt or table.clone(DG.base)
            filt[#filt + 1] = i
            avoidParams.FilterDescendantsInstances = filt
        end
        if filt then avoidParams.FilterDescendantsInstances = DG.base end
        return nil
    end

    -- 7 làn song song phía trước (cách nhau theo bề ngang máy bay), mỗi làn là 1 spherecast
    local LANES = {-4, -2.2, -1, 0, 1, 2.2, 4}
    local function laneShift(free, offs, from, to, step, look)
        for j = from, to, step do
            if free[j] >= look - 1 then return math.abs(offs[j]), true end
        end
        return math.abs(offs[to]), false
    end

    function updateDodge(pos, dir, speed)
        if not CFG.AvoidObstacles then DG.dir, DG.lat, DG.climb = 0, 0, 0; return 0 end
        local now = os.clock()
        if now - DG.lastScan < CFG.ScanRate then return DG.dir end
        DG.lastScan = now
        local look = math.clamp(CFG.ScanDist + speed * CFG.ScanTime, 25, 1000)
        local R = CFG.PlaneRadius
        local c = R + 3
        local side = Vector3.new(-dir.Z, 0, dir.X)
        local offs, free = {}, {}
        for i, k in ipairs(LANES) do
            offs[i] = k * c
            local res = blockingHit(pos + side * offs[i], dir * look, R)
            free[i] = res and res.Distance or look
        end
        local ahead = math.min(free[3], free[4], free[5])
        DG.ahead = ahead
        if ahead < look - 1 then
            local shR, clearR = laneShift(free, offs, 5, 7, 1, look)
            local shL, clearL = laneShift(free, offs, 3, 1, -1, look)
            local sl, sr = free[1] + free[2] + free[3], free[5] + free[6] + free[7]
            local pick
            if clearR ~= clearL then pick = clearR and 1 or -1
            elseif DG.dir == 0 then pick = (sr >= sl) and 1 or -1
            elseif DG.dir == 1 then pick = (sr * 1.25 >= sl) and 1 or -1
            else pick = (sl * 1.25 >= sr) and -1 or 1 end
            if DG.dir == 0 then
                log(("[NÉ] vật cản cách %d stud (quét %d) -> lái %s"):format(
                    math.floor(ahead), math.floor(look), pick > 0 and "phải" or "trái"))
            end
            DG.dir = pick
            DG.untilT = now + 0.45
            -- tốc độ đẩy ngang đủ để dịch ra khỏi làn bị chặn trước khi tới vật cản
            local shift = (pick == 1) and shR or shL
            DG.lat = math.clamp(shift * speed / math.max(ahead - R, 10) * 1.3, 15, CFG.DodgeSide)
            DG.climb = (not clearR and not clearL) and 1 or 0 -- kín cả 2 bên -> bay cao lên
        else
            DG.lat = DG.lat * 0.7
            if now > DG.untilT then DG.dir, DG.lat, DG.climb = 0, 0, 0 end
        end
        return DG.dir
    end
end
