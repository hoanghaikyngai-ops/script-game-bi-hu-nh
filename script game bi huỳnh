local avoidParams = RaycastParams.new()
avoidParams.FilterType = Enum.RaycastFilterType.Exclude
avoidParams.IgnoreWater = true
local DG = {dir = 0, untilT = 0, lat = 0, ahead = nil, climb = 0, lastScan = 0, base = {},
    obs = nil, obsDist = nil, hdiff = nil, vetoL = false, vetoR = false}
Rig.DG = DG

local function refreshAvoidFilter()
    local list = {}
    if lp.Character then list[#list + 1] = lp.Character end
    if planeCache then list[#list + 1] = planeCache end
    if Rig.folder then list[#list + 1] = Rig.folder end
    if fx.f then list[#list + 1] = fx.f end
    if routeFolder then list[#list + 1] = routeFolder end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then list[#list + 1] = p.Character end
    end
    for _, m in ipairs(CollectionService:GetTagged("Aircraft")) do
        if m ~= planeCache then list[#list + 1] = m end
    end
    DG.base = list
    avoidParams.FilterDescendantsInstances = list
end

local nameMatch
do
    local nameKwSrc, nameKw = nil, {}
    local nmCache = setmetatable({}, {__mode = "k"})
    function nameMatch(v)
        if not CFG.ObsOnlyNamed then return true end
        if CFG.ObsNames ~= nameKwSrc then
            nameKwSrc, nameKw = CFG.ObsNames, {}
            nmCache = setmetatable({}, {__mode = "k"})
            for tok in tostring(CFG.ObsNames):gmatch("[^,]+") do
                tok = viLower(tok:match("^%s*(.-)%s*$"))
                if tok ~= "" then nameKw[#nameKw + 1] = tok end
            end
        end
        local c = nmCache[v]
        if c ~= nil then return c end
        local res, p, depth = false, v, 0
        while p and p ~= workspace and p ~= game and depth < 6 do
            local n = viLower(p.Name)
            for _, k in ipairs(nameKw) do
                if n:find(k, 1, true) then res = true break end
            end
            if res then break end
            p = p.Parent
            depth += 1
        end
        nmCache[v] = res
        return res
    end
end

local canHitPlane
do
    local plColGrp = nil
    local cgCache = {}
    function canHitPlane(v)
        if not CFG.ObsFilter then return true end
        if v:IsA("Terrain") then return true end
        if not v.CanCollide then return false end
        local p = planeCache and partFromPlane(planeCache)
        local pg = p and p.CollisionGroup or "Default"
        local vg = v.CollisionGroup or "Default"
        if pg ~= plColGrp then plColGrp = pg; cgCache = {} end
        if pg == "Default" and vg == "Default" then return true end
        local ok = cgCache[vg]
        if ok == nil then
            local s, r = pcall(PhysicsService.CollisionGroupsAreCollidable, PhysicsService, pg, vg)
            ok = (not s) or r
            cgCache[vg] = ok
        end
        return ok
    end
end

local blockingHit, updateDodge
do
    local IGN = {"candy", "kẹo", "lolli", "sweet", "sugar", "coin", "gate", "cổng", "finish"}
    local function isIgnoredName(i)
        local n = i.Name:lower()
        local pn = (i.Parent and i.Parent ~= workspace) and i.Parent.Name:lower() or ""
        for _, k in ipairs(IGN) do
            if n:find(k, 1, true) or pn:find(k, 1, true) then return true end
        end
        return false
    end
    local function halfYOf(i)
        local cf, sz = i.CFrame, i.Size
        return math.abs(cf.RightVector.Y) * sz.X * 0.5 + math.abs(cf.UpVector.Y) * sz.Y * 0.5
            + math.abs(cf.LookVector.Y) * sz.Z * 0.5
    end
    local function topOf(i) return i.Position.Y + halfYOf(i) end

    local function cast(origin, vec, radius)
        if radius and radius > 0.5 then
            local ok, res = pcall(function() return workspace:Spherecast(origin, radius, vec, avoidParams) end)
            if ok then
                if res and res.Distance < 1.5 and res.Normal.Y > 0.5 then
                    return workspace:Raycast(origin, vec, avoidParams)
                end
                return res
            end
        end
        return workspace:Raycast(origin, vec, avoidParams)
    end

    function blockingHit(origin, vec, radius, planeBottom)
        local filt
        for _ = 1, 12 do
            local res = cast(origin, vec, radius)
            if not res then break end
            local i = res.Instance
            local lowEnough = false
            if planeBottom and i:IsA("BasePart") then lowEnough = topOf(i) <= planeBottom - 0.75 end
            local ghost = lowEnough or (not canHitPlane(i)) or (CFG.ObsOnlyNamed and not nameMatch(i)) or ((not i:IsA("Terrain")) and
                (i == curGate or i.Transparency >= 0.95 or not (i.CanCollide or i.CanTouch) or isIgnoredName(i)))
            if not ghost then
                if filt then avoidParams.FilterDescendantsInstances = DG.base end
                return res
            end
            filt = filt or table.clone(DG.base)
            filt[#filt + 1] = i
            avoidParams.FilterDescendantsInstances = filt
        end
        if filt then avoidParams.FilterDescendantsInstances = DG.base end
        return nil
    end

    function updateDodge(pos, dir, speed, plane)
        if not CFG.AvoidObstacles then
            DG.dir, DG.lat, DG.climb, DG.obs, DG.vetoL, DG.vetoR = 0, 0, 0, nil, false, false
            return 0
        end
        local now = os.clock()
        if now - DG.lastScan < CFG.ScanRate then return DG.dir end
        DG.lastScan = now

        local halfLen, planeBottom = 3, pos.Y - CFG.PlaneRadius
        if plane and plane:IsA("BasePart") then
            halfLen = math.max(plane.Size.X, plane.Size.Z) / 2
            planeBottom = pos.Y - halfYOf(plane)
        end
        local nose = pos + dir * halfLen
        local side = Vector3.new(-dir.Z, 0, dir.X)
        local dynLook = math.clamp(speed * 0.12, 0, 80)
        local trigger = CFG.AvoidDist + speed * CFG.AvoidTime + dynLook * 0.4
        local fanLen = math.max(CFG.FanLen + dynLook, trigger + 1)

        local nearest, leftMin, rightMin = nil, fanLen, fanLen
        local N, ang = math.max(3, CFG.FanRays), math.rad(CFG.FanAngle)
        for i = 0, N - 1 do
            local a = -ang + (2 * ang) * i / (N - 1)
            local v = CFrame.fromAxisAngle(Vector3.yAxis, a):VectorToWorldSpace(dir)
            local res = blockingHit(nose, v * fanLen, 0, planeBottom)
            if res then
                local d = res.Distance
                if not nearest or d < nearest.Distance then nearest = res end
                if a >= -1e-6 then leftMin = math.min(leftMin, d) end
                if a <= 1e-6 then rightMin = math.min(rightMin, d) end
            end
        end

        local sl = blockingHit(pos - side * CFG.SideOff, dir * CFG.SideLen, 0, planeBottom)
        local sr = blockingHit(pos + side * CFG.SideOff, dir * CFG.SideLen, 0, planeBottom)
        DG.vetoL, DG.vetoR = sl ~= nil, sr ~= nil

        DG.ahead = nearest and nearest.Distance or fanLen
        if nearest then
            DG.obs, DG.obsDist = nearest.Instance, nearest.Distance
            DG.hdiff = nearest.Instance:IsA("BasePart") and (topOf(nearest.Instance) - planeBottom) or 0
        else
            DG.obs, DG.obsDist, DG.hdiff = nil, nil, nil
        end

        if nearest and nearest.Distance <= trigger then
            if DG.dir == 0 or now >= DG.untilT then
                local pick
                if sl and not sr then pick = 1
                elseif sr and not sl then pick = -1
                else pick = (leftMin > rightMin) and -1 or 1 end
                DG.climb = (sl and sr) and 1 or 0
                if pick ~= DG.dir then
                    log(("[NÉ] %s cách mũi %.1f stud -> lái %s (2 bên: T=%s P=%s)"):format(
                        nearest.Instance.Name, nearest.Distance, pick > 0 and "phải" or "trái", tostring(sl ~= nil), tostring(sr ~= nil)))
                end
                DG.dir, DG.untilT = pick, now + 0.35
            end
            DG.lat = math.min(CFG.DodgeSide, 65)
        else
            DG.lat = DG.lat * 0.55
            if now > DG.untilT then DG.dir, DG.lat, DG.climb = 0, 0, 0 end
        end
        if DG.dir == 1 and sr then DG.dir = sl and 0 or -1
        elseif DG.dir == -1 and sl then DG.dir = sr and 0 or 1 end
        return DG.dir
    end
end

------------------------------------------------------------------
-- ESP ĐỎ: QUÉT TRƯỚC TOÀN MAP -> chọn vật nằm dọc hành lang tới ĐÍCH, đúng dải độ cao máy bay
------------------------------------------------------------------
local Obs = {list = {}, boxes = {}, scanning = false, ready = false, total = 0, shown = 0, lastScan = 0}
do
    local ESP_IGN = {"candy", "kẹo", "lolli", "sweet", "sugar", "coin", "gate", "cổng", "finish"}
    local function halfYOf(i)
        local cf, sz = i.CFrame, i.Size
        return math.abs(cf.RightVector.Y) * sz.X * 0.5 + math.abs(cf.UpVector.Y) * sz.Y * 0.5
            + math.abs(cf.LookVector.Y) * sz.Z * 0.5
    end

    local function eligible(v)
        if not v:IsA("BasePart") or v:IsA("Terrain") then return false end
        if (not v.Anchored) or (not v.CanCollide) or v.Transparency >= 0.95 then return false end
        local s = v.Size
        local mx = math.max(s.X, s.Y, s.Z)
        if mx < CFG.ObsMinSize then return false end
        if CFG.ObsSkipFloor and s.Y <= 4 and math.max(s.X, s.Z) >= 200 then return false end  -- bỏ nền/sàn khổng lồ
        if lp.Character and v:IsDescendantOf(lp.Character) then return false end
        if (fx.f and v:IsDescendantOf(fx.f)) or (routeFolder and v:IsDescendantOf(routeFolder))
            or (Rig.folder and v:IsDescendantOf(Rig.folder)) or (Obs.folder and v:IsDescendantOf(Obs.folder))
            or (planeCache and v:IsDescendantOf(planeCache)) then return false end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and v:IsDescendantOf(p.Character) then return false end
        end
        local nl = v.Name:lower()
        local pl = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
        for _, k in ipairs(ESP_IGN) do
            if nl:find(k, 1, true) or pl:find(k, 1, true) then return false end
        end
        if not canHitPlane(v) or not nameMatch(v) then return false end
        return true
    end

    local function entryOf(v)
        local pos, s = v.Position, v.Size
        local hy = halfYOf(v)
        return {p = v, x = pos.X, z = pos.Z, r = s.Magnitude / 2, bot = pos.Y - hy, top = pos.Y + hy}
    end

    -- ép map tải các đoạn dọc đường bay (StreamingEnabled)
    local function streamPath()
        if not workspace.StreamingEnabled then return end
        local r0 = root()
        local f = destPos()
        if not (r0 and f) then return end
        local a = r0.Position
        local n = math.min(15, math.max(1, math.floor((f - a).Magnitude / 450)))
        for i = 0, n do
            if not State.Running then return end
            pcall(function() lp:RequestStreamAroundAsync(a:Lerp(f, i / n), 2) end)
        end
    end

    function Obs.scan()
        if Obs.scanning then return end
        Obs.scanning = true
        task.spawn(function()
            pcall(streamPath)
            local list, n = {}, 0
            local ok, desc = pcall(function() return workspace:GetDescendants() end)
            if ok then
                for i, v in ipairs(desc) do
                    if not State.Running then break end
                    local ok2, el = pcall(eligible, v)
                    if ok2 and el then
                        local ok3, e = pcall(entryOf, v)
                        if ok3 then n += 1; list[n] = e end
                    end
                    if i % 2500 == 0 then task.wait() end
                end
            end
            Obs.list, Obs.total, Obs.ready, Obs.scanning, Obs.lastScan = list, n, true, false, os.clock()
            log(("[ESP] đã quét trước %d vật cứng trong map"):format(n))
        end)
    end

    -- vật mới xuất hiện sau khi quét: thêm vào cache
    bind(workspace.DescendantAdded:Connect(function(v)
        if not (Obs.ready and v:IsA("BasePart")) then return end
        task.defer(function()
            if not v.Parent then return end
            local ok, el = pcall(eligible, v)
            if ok and el then
                local ok2, e = pcall(entryOf, v)
                if ok2 then Obs.list[#Obs.list + 1] = e; Obs.total += 1 end
            end
        end)
    end))

    function Obs.wipe()
        for _, a in pairs(Obs.boxes) do pcall(function() a:Destroy() end) end
        Obs.boxes, Obs.shown = {}, 0
    end

    local function segDist(px, pz, ax, az, bx, bz)
        local dx, dz = bx - ax, bz - az
        local l2 = dx * dx + dz * dz
        local t = l2 > 0 and math.clamp(((px - ax) * dx + (pz - az) * dz) / l2, 0, 1) or 0
        local cx, cz = ax + dx * t, az + dz * t
        return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2), t
    end

    function Obs.select()
        local pc = (planeCache and planeCache.Parent) and planeCache or nil
        local pp = pc and partFromPlane(pc)
        local r0 = root()
        local A = (pp and pp.Position) or (r0 and r0.Position)
        if not A then return end
        local y = pp and A.Y or (A.Y + CFG.HoldHeight)

        -- đường bay: vị trí hiện tại -> các điểm lộ trình còn lại -> đích
        local pts = {A}
        if CFG.UseRoute then
            for i = math.max(1, Route.idx), #Route.pts do pts[#pts + 1] = Route.pts[i] end
        end
        if CFG.UseWaypoint and CFG.WpSet then pts[#pts + 1] = Vector3.new(CFG.WpX, CFG.WpY, CFG.WpZ) end
        local f = destPos()
        if f then pts[#pts + 1] = f end
        if #pts < 2 then
            local l = (r0 and r0.CFrame.LookVector) or Vector3.zAxis
            pts[2] = A + Vector3.new(l.X, 0, l.Z).Unit * 1500
        end

        local W, band = CFG.EspCorridor, CFG.EspBand
        local cand, n = {}, 0
        local list = Obs.list
        for i = 1, #list do
            local e = list[i]
            if e.p.Parent and e.bot <= y + band and e.top >= y - band then
                local cum, bestAlong
                cum = 0
                for s = 1, #pts - 1 do
                    local a, b = pts[s], pts[s + 1]
                    local segLen = math.sqrt((b.X - a.X) ^ 2 + (b.Z - a.Z) ^ 2)
                    local d, t = segDist(e.x, e.z, a.X, a.Z, b.X, b.Z)
                    if d <= W + e.r then
                        bestAlong = cum + t * segLen
                        break
                    end
                    cum += segLen
                end
                if bestAlong then n += 1; cand[n] = {e.p, bestAlong} end
            end
            if i % 5000 == 0 then task.wait() end
        end
        table.sort(cand, function(a, b) return a[2] < b[2] end)
        local want, cnt = {}, 0
        for i = 1, math.min(n, CFG.EspMax) do want[cand[i][1]] = true; cnt += 1 end
        for p, a in pairs(Obs.boxes) do
            if not want[p] or not p.Parent then pcall(function() a:Destroy() end); Obs.boxes[p] = nil end
        end
        if not (Obs.folder and Obs.folder.Parent) then
            Obs.folder = new("Folder", {Name = "HHubESP"}, workspace)
            Obs.boxes = {}
        end
        for p in pairs(want) do
            if not Obs.boxes[p] then
                Obs.boxes[p] = new("BoxHandleAdornment", {Adornee = p, Size = p.Size, AlwaysOnTop = true, ZIndex = 1,
                    Transparency = 0.5, Color3 = Color3.fromRGB(255, 40, 40)}, Obs.folder)
            end
        end
        Obs.shown = cnt
    end

    -- liệt kê loại vật chắn dọc đường vào Log
    function Obs.learn()
        local counts = {}
        for _, e in ipairs(Obs.list) do
            local p = e.p
            if p.Parent then
                local key = ("%s [Group=%s] <- %s"):format(p.Name, p.CollisionGroup or "?", p.Parent and p.Parent.Name or "?")
                counts[key] = (counts[key] or 0) + 1
            end
        end
        local rows = {}
        for k, c in pairs(counts) do rows[#rows + 1] = {k, c} end
        table.sort(rows, function(x, y) return x[2] > y[2] end)
        for i = 1, math.min(#rows, 30) do log(("[TÊN] %dx %s"):format(rows[i][2], rows[i][1])) end
        return #rows
    end
end

task.spawn(function()
    task.wait(2)
    Obs.scan()
    local lastPass = 0
    while State.Running do
        if CFG.ObsESP then
            if Obs.ready then pcall(Obs.select) end
            if not Obs.scanning and os.clock() - Obs.lastScan > 30 and not inFlight then Obs.scan() end
        else
            Obs.wipe()
        end
        task.wait(1)
    end
end)

