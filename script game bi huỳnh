local fx = {parts = {}}
local function fxRoot()
    if not (fx.f and fx.f.Parent) then
        fx.f = new("Folder", {Name = "HHubFX"}, workspace)
        fx.parts, fx.marker, fx.hl, fx.box = {}, nil, nil, nil
    end
    return fx.f
end
local function beam(key, a, b, color, thick, transp)
    local p = fx.parts[key]
    if not (a and b) or (b - a).Magnitude < 2 then
        if p then p.Transparency = 1 end
        return
    end
    local rootF = fxRoot()
    p = fx.parts[key]
    if not (p and p.Parent) then
        p = new("Part", {Name = "Beam_" .. key, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            CastShadow = false, Material = Enum.Material.Neon, Color = color}, rootF)
        fx.parts[key] = p
    end
    local v = b - a
    local l = math.min(v.Magnitude, 2000)
    local e = a + v.Unit * l
    p.Color, p.Transparency, p.Size = color, transp or 0.2, Vector3.new(thick, thick, l)
    p.CFrame = CFrame.lookAt((a + e) / 2, e)
end

local function fxMarker(pos)
    local m = fx.marker
    if not pos then
        if m and m.Parent then m.Transparency = 1 end
        return
    end
    local rootF = fxRoot()
    m = fx.marker
    if not (m and m.Parent) then
        m = new("Part", {Name = "Marker", Shape = Enum.PartType.Ball, Size = Vector3.one * 40, Anchored = true,
            CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon,
            Color = Color3.fromRGB(255, 60, 200)}, rootF)
        local bb = new("BillboardGui", {Size = UDim2.fromOffset(120, 30), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 32, 0)}, m)
        new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "ĐÍCH", TextColor3 = Color3.new(1, 1, 1),
            TextStrokeTransparency = 0, Font = Enum.Font.GothamBlack, TextSize = 20}, bb)
        fx.marker = m
    end
    m.Transparency = 0.35
    m.Position = pos
end

local radarHL
local function fxUpdate()
    local rootF = fxRoot()
    local pc = (planeCache and planeCache.Parent) and planeCache or nil
    local pp = pc and partFromPlane(pc)

    -- máy bay của mình: tô xanh
    if CFG.Radar and pc then
        if not (fx.hl and fx.hl.Parent) then
            fx.hl = new("Highlight", {FillTransparency = 0.45, OutlineTransparency = 0, FillColor = Color3.fromRGB(0, 255, 80),
                OutlineColor = Color3.fromRGB(0, 255, 80), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, rootF)
        end
        fx.hl.Adornee = pc
        if pp then
            if not (fx.box and fx.box.Parent) then
                fx.box = new("BoxHandleAdornment", {AlwaysOnTop = true, ZIndex = 2, Transparency = 0.6,
                    Color3 = Color3.fromRGB(0, 255, 80)}, rootF)
            end
            fx.box.Adornee = pp
            fx.box.Size = pp.Size * 1.15
        end
    else
        if fx.hl then fx.hl.Adornee = nil end
        if fx.box then fx.box.Adornee = nil end
    end

    -- radar vật chắn trước mũi
    if CFG.Radar and Rig.DG and Rig.DG.obs and Rig.DG.obs.Parent then
        if not (radarHL and radarHL.Parent) then
            radarHL = new("Highlight", {FillTransparency = 0.6, OutlineTransparency = 0,
                DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, rootF)
        end
        local col = (Rig.DG.hdiff or 0) < 0 and Color3.fromRGB(0, 255, 60) or Color3.fromRGB(255, 35, 35)
        radarHL.Adornee, radarHL.FillColor, radarHL.OutlineColor = Rig.DG.obs, col, col
    elseif radarHL then
        radarHL.Adornee = nil
    end

    -- tia dẫn đường + vệt tới đích
    local r0 = root()
    local from = (pp and pp.Position) or (r0 and r0.Position)
    local nxt = wpTarget() or destPos()
    local fin = destPos()
    if CFG.RouteShow and from and nxt then beam("guide", from, nxt, Color3.fromRGB(80, 255, 120), 2.5, 0.15)
    else beam("guide") end
    if CFG.GateLine and fin then
        beam("gp", r0 and r0.Position, fin, Color3.fromRGB(40, 120, 255), 1.2, 0.2)
        beam("gl", pp and pp.Position, fin, Color3.fromRGB(40, 120, 255), 1.6, 0.2)
    else
        beam("gp"); beam("gl")
    end
    fxMarker(fin)
end

