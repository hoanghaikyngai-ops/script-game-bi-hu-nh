local steerState = 0
local pressedKeys = {}
local function sendKey(code, down)
    pcall(function() VIM:SendKeyEvent(down, code, false, game) end)
end
local function releaseKeys()
    for code in pairs(pressedKeys) do
        sendKey(code, false)
        pressedKeys[code] = nil
    end
    steerState = 0
end
local function setSteer(s)
    if s == steerState then return end
    steerState = s
    local lk, rk = Enum.KeyCode.A, Enum.KeyCode.D
    if CFG.SteerKeys == 2 then lk, rk = Enum.KeyCode.Left, Enum.KeyCode.Right end
    local phys = CFG.SteerInvert and -s or s
    local want = {[lk] = phys < 0, [rk] = phys > 0}
    for code, on in pairs(want) do
        if on and not pressedKeys[code] then
            sendKey(code, true); pressedKeys[code] = true
        elseif (not on) and pressedKeys[code] then
            sendKey(code, false); pressedKeys[code] = nil
        end
    end
end

local function updateWaypoint(pos, dir, tgt)
    if not tgt then return 0 end
    local d = tgt - pos
    local flat = Vector3.new(d.X, 0, d.Z)
    local right = Vector3.new(-dir.Z, 0, dir.X)
    local lat = flat:Dot(right)
    local ahead = flat:Dot(dir)
    local dead = math.max(5, flat.Magnitude * 0.035)
    if lat > dead then return 1 elseif lat < -dead then return -1 end
    if ahead < 0 then return lat >= 0 and 1 or -1 end
    return 0
end

-- KẸO
local CANDY_KW = {"candy", "kẹo", "lolli", "sweet", "sugar"}
local candyList, lastCandyScan = {}, 0
local visited = setmetatable({}, {__mode = "k"})
local candyTarget
local lastCandyPick, lastCandyCheck = 0, 0

local function scanCandy()
    lastCandyScan = os.clock()
    local list = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character))
            and not (planeCache and v:IsDescendantOf(planeCache)) then
            local n = v.Name:lower()
            local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
            for _, k in ipairs(CANDY_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    list[#list + 1] = v
                    break
                end
            end
            if #list >= 500 then break end
        end
    end
    candyList = list
end

local function isCandyHit(inst, c)
    if inst == c then return true end
    local par = c.Parent
    return (par and par ~= workspace and inst:IsDescendantOf(par)) or false
end
local function candyClear(pos, c)
    local hit = blockingHit(pos, c.Position - pos)
    return (not hit) or isCandyHit(hit.Instance, c)
end

local function updateCandy(pos, dir)
    if not CFG.AutoCandy then candyTarget = nil; return 0 end
    local now = os.clock()
    if now - lastCandyScan > 3 then scanCandy() end
    local right = Vector3.new(-dir.Z, 0, dir.X)

    if candyTarget then
        if not candyTarget.Parent then
            candyTarget = nil
        else
            local d = candyTarget.Position - pos
            local ahead = d.X * dir.X + d.Z * dir.Z
            if ahead < -8 then
                visited[candyTarget] = now; candyTarget = nil
            elseif now - lastCandyCheck > 0.15 then
                lastCandyCheck = now
                if not candyClear(pos, candyTarget) then visited[candyTarget] = now; candyTarget = nil end
            end
        end
    end

    if not candyTarget and now - lastCandyPick > 0.25 then
        lastCandyPick = now
        local best, bestScore
        for i = #candyList, 1, -1 do
            local c = candyList[i]
            if not c.Parent then
                table.remove(candyList, i)
            elseif not (visited[c] and now - visited[c] < 3) then
                local d = c.Position - pos
                local ahead = d.X * dir.X + d.Z * dir.Z
                local lat = d.X * right.X + d.Z * right.Z
                if ahead > 5 and ahead < CFG.CandyAhead and math.abs(lat) <= CFG.CandyLateral and math.abs(d.Y) <= CFG.CandyHeight then
                    local score = ahead + math.abs(lat) * 0.5
                    if (not bestScore or score < bestScore) and candyClear(pos, c) then
                        best, bestScore = c, score
                    end
                end
            end
        end
        candyTarget = best
        if best then log("[KẸO] lái tới " .. best.Name) end
    end

    if not candyTarget then return 0 end
    local d = candyTarget.Position - pos
    if d.Magnitude < 12 and firetouchinterest then
        local pr = planeRoot()
        if pr then pcall(function() firetouchinterest(pr, candyTarget, 0); firetouchinterest(pr, candyTarget, 1) end) end
    end
    local lat = d.X * right.X + d.Z * right.Z
    if math.abs(lat) <= CFG.CandyDead then return 0 end
    return lat > 0 and 1 or -1
end

