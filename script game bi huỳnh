local queueTp = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or queueonteleport
local queued = false
local function queueAutoExec()
    if not CFG.AutoExecute or queued or not queueTp then return end
    if AUTOEXEC_URL == "" then return notify("Auto Execute", "Chưa đặt AUTOEXEC_URL ở đầu script") end
    queued = true
