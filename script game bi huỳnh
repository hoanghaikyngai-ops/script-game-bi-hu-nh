local steerState = 0
local pressedKeys = {}
local function sendKey(code, down)
    pcall(function() VIM:SendKeyEvent(down, code, false, game) end)
end
local function releaseKeys()
    for code in pairs(pressedKeys) do
        sendKey(code, false)
        pressedKeys[code] = nil
    end
    steerState = 0
end
local function setSteer(s)
    if s == steerState then return end
    steerState = s
    local lk, rk = Enum.KeyCode.A, Enum.KeyCode.D
    if CFG.SteerKeys == 2 then lk, rk = Enum.KeyCode.Left, Enum.KeyCode.Right end
    local phys = CFG.SteerInvert and -s or s
    local want = {[lk] = phys < 0, [rk] = phys > 0}
    for code, on in pairs(want) do
        if on and not pressedKeys[code] then
            sendKey(code, true); pressedKeys[code] = true
        elseif (not on) and pressedKeys[code] then
            sendKey(code, false); pressedKeys[code] = nil
        end
    end
end

-- NÉ VẬT CẢN
local dodgeDir, dodgeUntil = 0, 0
local function sideScore(pos, dir, side, s, look)
    local res = blockingHit(pos, side * s * 40)
    local sc = res and res.Distance or 40
    if pathBlocked(pos + side * s * 22, dir, look) then sc -= 25 end
    return sc
end
local function updateDodge(pos, dir, speed)
    if not CFG.AvoidObstacles then dodgeDir = 0; return 0 end
    local now = os.clock()
    local look = CFG.ScanDist + speed * CFG.ScanTime
    local side = Vector3.new(-dir.Z, 0, dir.X)
    if pathBlocked(pos, dir, look) then
        local sr = sideScore(pos, dir, side, 1, look)
        local sl = sideScore(pos, dir, side, -1, look)
        local pick
        if dodgeDir == 1 then pick = (sr >= sl - 5) and 1 or -1
        elseif dodgeDir == -1 then pick = (sl >= sr - 5) and -1 or 1
        else pick = (sr >= sl) and 1 or -1 end
        if dodgeDir == 0 then log(("[NÉ] vật cản trước %d stud -> lái %s"):format(math.floor(look), pick > 0 and "phải" or "trái")) end
        dodgeDir = pick
        dodgeUntil = now + 0.3
    elseif now > dodgeUntil then
        dodgeDir = 0
    end
    return dodgeDir
end

-- KẸO
local CANDY_KW = {"candy", "kẹo", "lolli", "sweet", "sugar"}
local candyList, lastCandyScan = {}, 0
local visited = setmetatable({}, {__mode = "k"})
local candyTarget
local lastCandyPick, lastCandyCheck = 0, 0

local function scanCandy()
    lastCandyScan = os.clock()
    local list = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character))
            and not (planeCache and v:IsDescendantOf(planeCache)) then
            local n = v.Name:lower()
            local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
            for _, k in ipairs(CANDY_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    list[#list + 1] = v
                    break
                end
            end
            if #list >= 500 then break end
        end
    end
    candyList = list
end

local function isCandyHit(inst, c)
    if inst == c then return true end
    local par = c.Parent
    return (par and par ~= workspace and inst:IsDescendantOf(par)) or false
end
local function candyClear(pos, c)
    local hit = blockingHit(pos, c.Position - pos)
    return (not hit) or isCandyHit(hit.Instance, c)
end

local function updateCandy(pos, dir)
    if not CFG.AutoCandy then candyTarget = nil; return 0 end
    local now = os.clock()
    if now - lastCandyScan > 3 then scanCandy() end
    local right = Vector3.new(-dir.Z, 0, dir.X)

    if candyTarget then
        if not candyTarget.Parent then
            candyTarget = nil
        else
            local d = candyTarget.Position - pos
            local ahead = d.X * dir.X + d.Z * dir.Z
            if ahead < -8 then
                visited[candyTarget] = now; candyTarget = nil
            elseif now - lastCandyCheck > 0.15 then
                lastCandyCheck = now
                if not candyClear(pos, candyTarget) then visited[candyTarget] = now; candyTarget = nil end
            end
        end
    end

    if not candyTarget and now - lastCandyPick > 0.25 then
        lastCandyPick = now
        local best, bestScore
        for i = #candyList, 1, -1 do
            local c = candyList[i]
            if not c.Parent then
                table.remove(candyList, i)
            elseif not (visited[c] and now - visited[c] < 3) then
                local d = c.Position - pos
                local ahead = d.X * dir.X + d.Z * dir.Z
                local lat = d.X * right.X + d.Z * right.Z
                if ahead > 5 and ahead < CFG.CandyAhead and math.abs(lat) <= CFG.CandyLateral and math.abs(d.Y) <= CFG.CandyHeight then
                    local score = ahead + math.abs(lat) * 0.5
                    if (not bestScore or score < bestScore) and candyClear(pos, c) then
                        best, bestScore = c, score
                    end
                end
            end
        end
        candyTarget = best
        if best then log("[KẸO] lái tới " .. best.Name) end
    end

    if not candyTarget then return 0 end
    local d = candyTarget.Position - pos
    if d.Magnitude < 12 and firetouchinterest then
        local pr = planeRoot()
        if pr then pcall(function() firetouchinterest(pr, candyTarget, 0); firetouchinterest(pr, candyTarget, 1) end) end
    end
    local lat = d.X * right.X + d.Z * right.Z
    if math.abs(lat) <= CFG.CandyDead then return 0 end
    return lat > 0 and 1 or -1
end

------------------------------------------------------------------
-- TĂNG TỐC MÁY BAY
------------------------------------------------------------------
local moverList, lastMoverScan, speedRef = {}, 0, nil

local function scanMovers()
    lastMoverScan = os.clock()
    local list = {}
    local scope = planeCache and planeCache.Parent and planeCache or nil
    if scope then
        local function consider(d)
            if d:IsA("LinearVelocity") or d:IsA("BodyVelocity") then list[#list + 1] = {inst = d} end
        end
        consider(scope)
        for _, d in ipairs(scope:GetDescendants()) do consider(d) end
    end
    moverList = list
end

local function applyMovers(mult)
    for i = #moverList, 1, -1 do
        local m = moverList[i]
        local inst = m.inst
        if not inst.Parent then
            table.remove(moverList, i)
        else
            local isBV = inst:IsA("BodyVelocity")
            local prop = isBV and "Velocity" or "VectorVelocity"
            if (not isBV) and inst.VelocityConstraintMode == Enum.VelocityConstraintMode.Line then prop = "LineVelocity" end
            local ok = pcall(function()
                local cur = inst[prop]
                local changed
                if m.last == nil then changed = true
                elseif typeof(cur) == "Vector3" then changed = (cur - m.last).Magnitude > 0.01
                else changed = math.abs(cur - m.last) > 0.01 end
                if changed then m.orig = cur end
                m.last = m.orig * mult
                inst[prop] = m.last
            end)
            if not ok then table.remove(moverList, i) end
        end
    end
    return #moverList > 0
end

local function applySpeed(r, dir, now, dt)
    if not CFG.SpeedBoost or r == root() then return end -- không tăng tốc khi chưa nhận được máy bay
    local v = r.AssemblyLinearVelocity
    local hs = Vector3.new(v.X, 0, v.Z).Magnitude
    if not State.speedStart then
        if hs > 5 then State.speedStart = now; speedRef = hs end
        return
    end
    if now - State.speedStart < 0.5 then
        if hs > speedRef then speedRef = hs end
        return
    end
    if not speedRef or speedRef < 5 then State.speedStart = nil; return end

    if State.cfMode then
        r.CFrame = r.CFrame + dir * speedRef * (CFG.SpeedMult - 1) * dt
        return
    end

    if now - lastMoverScan > 1 then scanMovers() end
    if not applyMovers(CFG.SpeedMult) then
        local hv = Vector3.new(v.X, 0, v.Z)
        local heading = hv.Magnitude > 3 and hv.Unit or dir
        local target = speedRef * CFG.SpeedMult
        r.AssemblyLinearVelocity = Vector3.new(heading.X * target, v.Y, heading.Z * target)
    end
    if CFG.SpeedMult >= 2 and hs < speedRef * CFG.SpeedMult * 0.5 then
        State.bad = (State.bad or 0) + dt
        if State.bad > 0.6 then State.cfMode = true; log("[TỐC] vận tốc không ăn -> chuyển sang dịch CFrame") end
    else
        State.bad = 0
    end
end

------------------------------------------------------------------
-- VÒNG ĐIỀU KHIỂN MÁY BAY MỖI KHUNG HÌNH
------------------------------------------------------------------
local function flightStep()
    if not (inFlight and not reachedGate) then
        if thrustForce then clearThrust() end
        if steerState ~= 0 then setSteer(0) end
        return
    end
    local r = planeRoot()
    if not r then return end
    local now = os.clock()
    local dt = now - (State.lastStep or now)
    State.lastStep = now
    baseY = baseY or r.Position.Y
    if not gateChosen then gateChosen = true; curGate = pickGate() end

    local pos = r.Position
    local vel = r.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local speed = hv.Magnitude
    local dir
    if speed > 3 then
        dir = hv.Unit
    else
        local l = r.CFrame.LookVector
        dir = Vector3.new(l.X, 0, l.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
        dir = dir.Unit
    end

    if curGate and curGate.Parent then
        local d = curGate.Position - pos
        if Vector3.new(d.X, 0, d.Z).Magnitude <= GATE_STOP + curGate.Size.Magnitude / 4 then
            reachedGate = true
            clearThrust()
            setSteer(0)
            if firetouchinterest then
                pcall(function() firetouchinterest(r, curGate, 0); firetouchinterest(r, curGate, 1) end)
            end
            notify("Cổng", "Đã chạm cổng cuối")
            return
        end
    end

    if CFG.KeepFlying and not r.Anchored and r ~= root() then
        ensureThrust(r)
        local g = workspace.Gravity
        local up = g + math.clamp((baseY + CFG.HoldHeight - pos.Y) * 6, -g * 0.8, CFG.Lift)
        local push = speed < CFG.FlySpeed and CFG.Push or 0
        thrustForce.Force = Vector3.new(dir.X * push, up, dir.Z * push) * r.AssemblyMass
    elseif thrustForce then
        clearThrust()
    end

    refreshAvoidFilter()
    local d = updateDodge(pos, dir, speed)
    local c = (d == 0) and updateCandy(pos, dir) or 0
    setSteer(d ~= 0 and d or c)

    applySpeed(r, dir, now, dt)
end

bind(RunService.Heartbeat:Connect(function()
    local ok, err = pcall(flightStep)
    if not ok and State.lastErr ~= tostring(err) then
        State.lastErr = tostring(err)
        log("[LOI bay] " .. State.lastErr)
    end
end))

