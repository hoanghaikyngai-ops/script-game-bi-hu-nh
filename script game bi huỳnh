local MusicSound = new("Sound", {Name = "HHubMusicTrack", Volume = CFG.Volume, Looped = true}, SoundService)
local Music = {CurrentId = nil, CurrentName = "Chưa phát", PlayToken = 0, Index = 0}

local function MusicCleanup()
    pcall(function() MusicSound:Stop(); MusicSound:Destroy() end)
end

local function playId(id, label, from, to)
    local numeric = tostring(id):match("%d+")
    if not numeric then return false end
    Music.PlayToken += 1
    local token = Music.PlayToken
    MusicSound.SoundId = "rbxassetid://" .. numeric
    Music.CurrentId = numeric
    Music.CurrentName = label or ("ID " .. numeric)
    if from then MusicSound.TimePosition = from end
    pcall(function() MusicSound:Play() end)
    if from or to then
        task.spawn(function()
            for _ = 1, 100 do
                if MusicSound.IsLoaded then break end
                task.wait(0.1)
            end
            if token ~= Music.PlayToken then return end
            if from then MusicSound.TimePosition = from end
            while State.Running and token == Music.PlayToken and MusicSound.Playing and (not to or MusicSound.TimePosition < to) do
                task.wait(0.1)
            end
            if to and token == Music.PlayToken and MusicSound.Playing then MusicSound:Pause() end
        end)
    end
    notify("Đang phát", Music.CurrentName)
    return true
end

local function playIndex(i)
    local n = #MusicPlaylist
    Music.Index = ((i - 1) % n) + 1
    local t = MusicPlaylist[Music.Index]
    playId(t.Id, t.Name, t.From, t.To)
end

