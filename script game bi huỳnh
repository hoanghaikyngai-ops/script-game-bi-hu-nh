-- Giữ chuột, thả khi lực đủ 100%
local function holdThrow(manual)
    local x, y = pickClickPoint()
    pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
    task.wait(0.05)
    mouseBtn(x, y, true)
    local t0 = os.clock()
    local seen, seenLow, reached = false, false, false
    local lastV
    while State.Running and (CFG.AutoThrow or manual) do
        local el = os.clock() - t0
        local v = readPower(true)
        if v then
            seen, lastV = true, v
            if v < CFG.PowerTarget then seenLow = true end
            if v >= CFG.PowerTarget and (seenLow or el > 0.4) then reached = true break end
        end
        if el >= CFG.MaxCharge then break end
        if (not seen) and el >= math.max(CFG.ChargeHold, 2) then break end
        task.wait()
    end
    mouseBtn(x, y, false)
    if reached then
        log("[THROW] thả lúc lực " .. string.format("%.0f%%", (lastV or 1) * 100))
    elseif seen then
        log("[THROW] hết giờ giữ, lực cuối " .. string.format("%.0f%%", (lastV or 0) * 100))
    else
        log("[THROW] không thấy thanh lực -> thả theo thời gian giữ. Dùng nút 'Chọn thanh lực'")
    end
    return reached
end

