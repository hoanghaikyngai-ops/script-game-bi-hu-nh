    State.finStart, State.finDist = nil, nil
    DG.dir, DG.untilT, DG.lat, DG.climb, DG.lastScan = 0, 0, 0, 0, 0
    releaseKeys()
    Route.idx = 1
    if CFG.LockPlayer then lockPlayer(true) end

    task.wait(CFG.ReadyDelay)

    throwStartT = os.clock()
    holdThrow()
    throws += 1
    inFlight = true

    local t0 = os.clock()
    local seenPlane, still = nil, 0
    local reason = "hết giờ"
    local lastTick = os.clock()

    while State.Running and CFG.AutoThrow do
        local now = os.clock()
        local dt = now - lastTick
        lastTick = now
        local elapsed = now - t0

        if ended then reason = "server báo kết thúc"; break end
        if elapsed >= CFG.MaxFlight then reason = "quá thời gian bay"; break end
        if reachedGate then reason = "tới đích"; break end

        if (CFG.SteerRemote or State.remoteSteer) and Remote and flightId then
            pcall(function() Remote:FireServer("Steer", flightId, CFG.SteerInvert and -steerState or steerState, CFG.RigSendY and Rig.climbCmd or CFG.SteerY) end)
        end
        if CFG.BoostRemote ~= "" and now - lastBoost >= CFG.BoostEvery then
            lastBoost = now
            fireBoost()
        end

        local p = findPlane()
        if p and p ~= root() and not (lp.Character and p:IsDescendantOf(lp.Character)) then seenPlane = p end
        if seenPlane and not seenPlane.Parent and elapsed > 3 then
            ended = true; reason = "máy bay biến mất"; break
        end
        local pr = seenPlane and seenPlane.Parent and partFromPlane(seenPlane)
        if elapsed > 3 and pr then
            if pr.AssemblyLinearVelocity.Magnitude < 2 then
                still += dt
                if still > CFG.StillTime then ended = true; reason = "máy bay đáp đất"; break end
            else
                still = 0
            end
        end
        task.wait(CFG.SteerRate)
    end

    if reachedGate and not ended then
        local t1 = os.clock()
        still = 0
        local last = os.clock()
        while State.Running and CFG.AutoThrow and not ended and os.clock() - t1 < CFG.GateWait do
            local now = os.clock()
            local dt = now - last
            last = now
            if seenPlane and not seenPlane.Parent then break end
            local pr = seenPlane and seenPlane.Parent and partFromPlane(seenPlane)
            if pr and pr.AssemblyLinearVelocity.Magnitude < 2 then
                still += dt
                if still > CFG.StillTime then break end
            else
                still = 0
            end
            task.wait(0.1)
        end
    end

    inFlight = false
    clearThrust()
    releaseKeys()
    log("[INFO] Lượt " .. throws .. " xong: " .. reason)

    if CFG.LandTap and State.Running and CFG.AutoThrow then
        task.wait(0.25)
        tapScreen()
        task.wait(0.3)
    end
end

