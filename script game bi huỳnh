bind(RunService.RenderStepped:Connect(function()
    if not (grad and main and main.Visible) then return end
    local t = os.clock()
    grad.Rotation = (t * 140) % 360
    glowGrad.Rotation = (t * 140) % 360
    stripGrad.Offset = Vector2.new(((t * 0.6) % 2) - 1, 0)
    for i, d in ipairs(dots) do
        local b = (math.sin(t * 4 + i * 0.7) + 1) / 2
        d.BackgroundColor3 = Color3.fromHSV((t * 0.2 + i / 10) % 1, 1, 1)
        d.BackgroundTransparency = 0.75 - b * 0.75
    end
end))

task.spawn(function()
    while State.Running do
        pcall(function()
            local gained = getCoins() - startCoins
            local hrs = (os.clock() - State.t0) / 3600
            status.Text = ("Ném: %d | Coin +%s (%s/giờ) | Vị trí: %s\nThanh lực: %s | Lực cuối: %s"):format(
                throws, abbr(gained), abbr(hrs > 0.003 and gained / hrs or 0),
                (zoneCache and zoneCache.Parent and "Khu vực phóng ✓") or (throwSpot and "đã lưu") or "chưa",
                lastMeterName and ("✓ " .. lastMeterName) or "chưa thấy",
                lastPower and string.format("%.0f%%", lastPower * 100) or "-")
            local pr = inFlight and planeRoot()
            local dist = ""
            if pr and curGate and curGate.Parent then
                local d = curGate.Position - pr.Position
                dist = (" | còn %d stud"):format(math.floor(Vector3.new(d.X, 0, d.Z).Magnitude))
            end
            flyInfo.Text = ("Cổng: %s (%d vật khớp)%s\nTrạng thái: %s\nBay: %s | Lái: %d | né: %d (cách %s)\nTốc: %s | thực %d stud/s"):format(
                curGate and curGate.Name or "chưa chọn", #gates, dist,
                reachedGate and "đã chạm cổng" or (inFlight and "đang bay" or "chờ ném"),
                (planeCache and planeCache.Parent) and planeCache.Name or "chưa nhận",
                steerState, DG.dir, DG.ahead and tostring(math.floor(DG.ahead)) or "-",
                State.cfMode and "CFrame" or (State.velMode and "vận tốc" or "mover"),
                math.floor(State.actual or 0))
            farmInfo.Text = "Fam lực: " .. (CFG.FarmPower and farmStatus or "tắt") ..
                "\nKhu vực: " .. ((lastUnlockPart and lastUnlockPart.Parent and lastUnlockPart.Name) or "chưa chọn")
            nowPlaying.Text = "♪ " .. Music.CurrentName .. (MusicSound.Playing and "  (đang phát)" or "  (tạm dừng)")
            local n, tail = #logs, {}
            for i = math.max(1, n - 11), n do tail[#tail + 1] = logs[i] end
            logLabel.Text = table.concat(tail, "\n")
        end)
        task.wait(1)
    end
end)

task.spawn(function()
    while State.Running and not (zoneCache and zoneCache.Parent) do
        findZone()
        task.wait(3)
    end
end)

getgenv().PPHubUnload = function()
    State.Running = false
    inFlight = false
    pickMode = false
    pcall(releaseKeys)
    clearThrust()
    stopFly()
    clearESP()
    if CFG.FullBright then restoreLight("bright") end
    if CFG.NoFog then restoreLight("fog") end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    MusicCleanup()
    pcall(function() blur:Destroy() end)
    pcall(function() gui:Destroy() end)
    getgenv().PPHubUnload = nil
end

