local function abbr(n)
    n = tonumber(n) or 0
    local a = math.abs(n)
    if a >= 1e9 then return ("%.2fB"):format(n / 1e9)
    elseif a >= 1e6 then return ("%.2fM"):format(n / 1e6)
    elseif a >= 1e3 then return ("%.1fK"):format(n / 1e3) end
    return tostring(math.floor(n))
end

