    end
    steerState = 0
end
local function setSteer(s)
    if s == steerState then return end
    steerState = s
    local lk, rk = Enum.KeyCode.A, Enum.KeyCode.D
    if CFG.SteerKeys == 2 then lk, rk = Enum.KeyCode.Left, Enum.KeyCode.Right end
    local phys = CFG.SteerInvert and -s or s
    local want = {[lk] = phys < 0, [rk] = phys > 0}
    for code, on in pairs(want) do
        if on and not pressedKeys[code] then
            sendKey(code, true); pressedKeys[code] = true
        elseif (not on) and pressedKeys[code] then
            sendKey(code, false); pressedKeys[code] = nil
        end
    end
end


-- KẸO
local CANDY_KW = {"candy", "kẹo", "lolli", "sweet", "sugar"}
local candyList, lastCandyScan = {}, 0
local visited = setmetatable({}, {__mode = "k"})
local candyTarget
local lastCandyPick, lastCandyCheck = 0, 0

local function scanCandy()
    lastCandyScan = os.clock()
    local list = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character))
            and not (planeCache and v:IsDescendantOf(planeCache)) then
            local n = v.Name:lower()
            local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
            for _, k in ipairs(CANDY_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    list[#list + 1] = v
                    break
                end
            end
            if #list >= 500 then break end
        end
    end
    candyList = list
end

local function isCandyHit(inst, c)
    if inst == c then return true end
    local par = c.Parent
    return (par and par ~= workspace and inst:IsDescendantOf(par)) or false
end
local function candyClear(pos, c)
    local hit = blockingHit(pos, c.Position - pos)
    return (not hit) or isCandyHit(hit.Instance, c)
end

local function updateCandy(pos, dir)
    if not CFG.AutoCandy then candyTarget = nil; return 0 end
    local now = os.clock()
    if now - lastCandyScan > 3 then scanCandy() end
    local right = Vector3.new(-dir.Z, 0, dir.X)

    if candyTarget then
        if not candyTarget.Parent then
            candyTarget = nil
        else
            local d = candyTarget.Position - pos
            local ahead = d.X * dir.X + d.Z * dir.Z
            if ahead < -8 then
                visited[candyTarget] = now; candyTarget = nil
            elseif now - lastCandyCheck > 0.15 then
                lastCandyCheck = now
                if not candyClear(pos, candyTarget) then visited[candyTarget] = now; candyTarget = nil end
            end
        end
    end

    if not candyTarget and now - lastCandyPick > 0.25 then
        lastCandyPick = now
        local best, bestScore
        for i = #candyList, 1, -1 do
            local c = candyList[i]
            if not c.Parent then
                table.remove(candyList, i)
            elseif not (visited[c] and now - visited[c] < 3) then
                local d = c.Position - pos
                local ahead = d.X * dir.X + d.Z * dir.Z
                local lat = d.X * right.X + d.Z * right.Z
                if ahead > 5 and ahead < CFG.CandyAhead and math.abs(lat) <= CFG.CandyLateral and math.abs(d.Y) <= CFG.CandyHeight then
                    local score = ahead + math.abs(lat) * 0.5
                    if (not bestScore or score < bestScore) and candyClear(pos, c) then
                        best, bestScore = c, score
                    end
                end
            end
        end
        candyTarget = best
        if best then log("[KẸO] lái tới " .. best.Name) end
    end

    if not candyTarget then return 0 end
    local d = candyTarget.Position - pos
    if d.Magnitude < 12 and firetouchinterest then
        local pr = planeRoot()
        if pr then pcall(function() firetouchinterest(pr, candyTarget, 0); firetouchinterest(pr, candyTarget, 1) end) end
    end
    local lat = d.X * right.X + d.Z * right.Z
    if math.abs(lat) <= CFG.CandyDead then return 0 end
    return lat > 0 and 1 or -1
end

local moverList, lastMoverScan, speedRef = {}, 0, nil
local applySpeed
do
    local moverState = setmetatable({}, {__mode = "k"})

    local function moverProp(inst)
        if inst:IsA("BodyVelocity") then return "Velocity" end
        local mode = inst.VelocityConstraintMode
        if mode == Enum.VelocityConstraintMode.Line then return "LineVelocity" end
        if mode == Enum.VelocityConstraintMode.Plane then return "PlaneVelocity" end
        return "VectorVelocity"
    end

    local function scanMovers()
        lastMoverScan = os.clock()
        local list, seen = {}, {}
        local function consider(d)
            if not seen[d] and (d:IsA("LinearVelocity") or d:IsA("BodyVelocity")) then
                seen[d] = true
                local m = moverState[d]
                if not m then m = {inst = d}; moverState[d] = m end
                list[#list + 1] = m
            end
        end
        local scope = planeCache and planeCache.Parent and planeCache or nil
        if scope then
            consider(scope)
            for _, d in ipairs(scope:GetDescendants()) do consider(d) end
            local part = partFromPlane(scope)
            if part then
                local ok, conn = pcall(function() return part:GetConnectedParts(true) end)
                if ok then
                    for _, p in ipairs(conn) do
                        for _, d in ipairs(p:GetChildren()) do consider(d) end
                    end
                end
            end
            if scope:IsA("BasePart") and scope.Parent and scope.Parent:IsA("Model") and scope.Parent ~= workspace then
                for _, d in ipairs(scope.Parent:GetDescendants()) do consider(d) end
            end
        end
        moverList = list
    end

    local function applyMovers(mult)
        local any = false
        for i = #moverList, 1, -1 do
            local m = moverList[i]
            local inst = m.inst
            if not inst.Parent then
                table.remove(moverList, i)
            else
                local ok = pcall(function()
                    local prop = moverProp(inst)
                    m.prop = prop
                    if not m.forced then
                        m.forced = true
                        if inst:IsA("BodyVelocity") then
                            inst.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        else
                            inst.MaxForce = math.huge
                            pcall(function() inst.MaxAxesForce = Vector3.new(math.huge, math.huge, math.huge) end)
                        end
                    end
                    local cur = inst[prop]
                    local changed
                    if m.last == nil then changed = true
                    elseif type(cur) == "number" then changed = math.abs(cur - m.last) > 0.01
                    else changed = (cur - m.last).Magnitude > 0.01 end
                    if changed then m.orig = cur end -- game vừa ghi giá trị mới -> lấy làm gốc
                    m.last = m.orig * mult
                    inst[prop] = m.last
                end)
                if ok then any = true else table.remove(moverList, i) end
            end
        end
        return any
    end

    local function restoreMovers()
        for _, m in ipairs(moverList) do
            if m.orig ~= nil and m.prop and m.inst.Parent then
                pcall(function() m.inst[m.prop] = m.orig end)
            end
        end
    end

    local function hlen(v) return math.sqrt(v.X * v.X + v.Z * v.Z) end

    function applySpeed(r, dir, now, dt)
        local v = r.AssemblyLinearVelocity
        local hs = hlen(v)
        local pos = r.Position
        local actual = hs
        if State.lastPos and dt > 0 then actual = hlen(pos - State.lastPos) / dt end
        State.lastPos = pos
        State.actual = actual

        -- đo tốc độ gốc ở 0.35s đầu khi máy bay thật sự chuyển động
        if not State.speedStart then
            if hs > 5 then State.speedStart = now; speedRef = hs end
            return
        end
        if now - State.speedStart < 0.35 then
            if hs > speedRef then speedRef = hs end
            return
        end
        if not speedRef or speedRef < 5 then State.speedStart = nil; return end

        local mult, mode = CFG.SpeedMult, CFG.SpeedMode
        if mode == 3 or State.cfMode then
            r.CFrame = r.CFrame + dir * speedRef * (mult - 1) * dt
            return
        end

        local moved = false
        if mode ~= 2 and not State.velMode then
            if now - lastMoverScan > 1 then scanMovers() end
            moved = applyMovers(mult)
        end
        if not moved then
            local hv = Vector3.new(v.X, 0, v.Z)
            local heading = hv.Magnitude > 3 and hv.Unit or dir
            local target = speedRef * mult
            r.AssemblyLinearVelocity = Vector3.new(heading.X * target, v.Y, heading.Z * target)
        end

        -- chế độ tự động: không ăn thì chuyển mover -> ghi đè vận tốc -> dịch CFrame
        if mode == 0 and mult >= 2 and now - State.speedStart > 0.9 then
            if actual < speedRef * mult * 0.6 then
                State.bad = (State.bad or 0) + dt
                if State.bad > 0.5 then
                    State.bad = 0
                    if moved then
                        restoreMovers()
                        State.velMode = true
                        log("[TỐC] mover không ăn -> ghi đè vận tốc")
                    elseif not State.cfMode then
                        State.cfMode = true
                        log("[TỐC] vận tốc không ăn -> dịch CFrame")
                    end
                end
            else
                State.bad = 0
            end
        end
    end

    -- ghi ở Stepped = ngay trước bước vật lý, sau mọi script RenderStepped của game
    bind(RunService.Stepped:Connect(function(_, dt)
        if not (CFG.SpeedBoost and inFlight and not reachedGate) then return end
        local r = State.pr
        if not (r and r.Parent) or r == root() or r.Anchored then return end
        pcall(applySpeed, r, State.dir or Vector3.new(0, 0, -1), os.clock(), dt)
    end))
end

