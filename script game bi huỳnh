local guiPool, holdThrow
do
    local pool, poolSet, poolAt, poolHooked = {}, {}, -100, false
    local function poolAdd(d)
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not poolSet[d] then
            poolSet[d] = true
            pool[#pool + 1] = d
        end
    end
    function guiPool(force)
        local now = os.clock()
        if force or now - poolAt > 40 then   -- đã có DescendantAdded nên không cần quét lại thường xuyên
            poolAt = now
            pool, poolSet = {}, {}
            local pg = lp:FindFirstChildOfClass("PlayerGui")
            if pg then for _, d in ipairs(pg:GetDescendants()) do poolAdd(d) end end
            for _, d in ipairs(workspace:GetDescendants()) do poolAdd(d) end
            if not poolHooked then
                poolHooked = true
                if pg then bind(pg.DescendantAdded:Connect(poolAdd)) end
                bind(workspace.DescendantAdded:Connect(poolAdd))
            end
        end
        return pool
    end

    local METER_KW = {"power", "charge", "lực", "luc", "force", "meter", "strength", "throw"}
    local function nameHas(inst)
        local p, n = inst, 0
        while p and p ~= game and n < 5 do
            local s = viLower(p.Name)
            for _, k in ipairs(METER_KW) do
                if s:find(k, 1, true) then return true end
            end
            p = p.Parent
            n += 1
        end
        return false
    end

    local function pctOnly(t)
        t = (tostring(t):gsub("<[^>]->", ""))
        return t:match("^%s*%d+[%.,]?%d*%s*%%%s*$") ~= nil
    end

    local function newTracker()
        local T = {items = {}, ignored = setmetatable({}, {__mode = "k"}),
            base = setmetatable({}, {__mode = "k"}), lastScan = -10}
        local function isPctLabel(o)
            return (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text:find("%d%s*%%") ~= nil and visibleChain(o)
        end
        function T:snapshot()
            for _, o in ipairs(guiPool()) do
                if o.Parent and isPctLabel(o) then self.base[o] = o.Text end
            end
        end
        function T:scan(now)
            self.lastScan = now
            for _, o in ipairs(guiPool()) do
                if o.Parent and not self.items[o] and not self.ignored[o] and isPctLabel(o) then
                    if self.base[o] == nil or self.base[o] ~= o.Text then
                        self.items[o] = {v = readObj(o), born = now, n = 0, hist = {}, lo = 9, hi = -9,
                            pure = pctOnly(o.Text), sawLow = false}
                    end
                end
            end
        end
        function T:update(now)
            local lowMark = CFG.PowerGoal - 0.05
            for o, s in pairs(self.items) do
                if not o.Parent then
                    self.items[o] = nil
                else
                    local v = readObj(o)
                    if v then
                        if s.v and math.abs(v - s.v) > 1e-4 then
                            s.n += 1
                            s.tChange = now
                            local h = s.hist
                            h[#h + 1] = {now, v}
                            if #h > 12 then table.remove(h, 1) end
                        end
                        if v < s.lo then s.lo = v end
                        if v > s.hi then s.hi = v end
                        if v < lowMark then s.sawLow = true end   -- đã thấy thanh tụt xuống thấp = đã reset thật
                        s.v = v
                    end
                    if not s.manual and s.n < 4 and now - (s.tChange or s.born) > 1.5 then
                        self.items[o] = nil
                        self.ignored[o] = true
                    end
                end
            end
        end
        function T:best()
            local bo, bs, bscore
            for o, s in pairs(self.items) do
                if s.n >= 1 or s.manual then
                    local range = (s.hi >= s.lo) and (s.hi - s.lo) or 0
                    local score = math.min(s.n, 30) + range * 40 + (s.pure and 8 or 0)
                        + (nameHas(o) and 3 or 0) + (s.manual and 100 or 0)
                    if not bscore or score > bscore then bo, bs, bscore = o, s, score end
                end
            end
            return bs, bo
        end
        return T
    end

    local function rateOf(s)
        local h = s.hist
        local n = #h
        if n < 2 then return 0 end
        local b = h[n]
        local a = b
        for i = n - 1, 1, -1 do
            if b[1] - h[i][1] > 0.18 then break end
            a = h[i]
        end
        local dt = b[1] - a[1]
        if dt < 0.03 then a = h[n - 1]; dt = b[1] - a[1] end
        if dt <= 0 then return 0 end
        return (b[2] - a[2]) / dt
    end

    local function dumpCand(T)
        local rows = {}
        for o, s in pairs(T.items) do
            if s.n >= 1 or s.manual then
                local ok = s.hi >= s.lo
                rows[#rows + 1] = ("%s.%s n=%d %.0f-%.0f%%"):format(o.Parent and o.Parent.Name or "?", o.Name,
                    s.n, (ok and s.lo or 0) * 100, (ok and s.hi or 0) * 100)
            end
        end
        table.sort(rows)
        return table.concat(rows, " | ", 1, math.min(#rows, 4))
    end

    local function holdMeter(manual)
        local T = newTracker()
        local t00 = os.clock()
        T:snapshot()
        if meterObj and meterObj.Parent then
            T.items[meterObj] = {v = readObj(meterObj), born = t00, n = 0, hist = {}, lo = 9, hi = -9, manual = true, sawLow = false}
        end
        local x, y = pickClickPoint()
        pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
        local t0 = os.clock()
        mouseBtn(x, y, true)
        local goal = CFG.PowerGoal
        local lead = math.clamp(CFG.Lead, 0, 0.25)
        local released, active, activeS, vRel, lastV, rateRel = false, nil, nil, nil, nil, 0
        local fdt = 1 / 60
        local fallback = (CFG.CalTime >= 0.3) and CFG.CalTime or math.max(CFG.ChargeHold, 2)

        while State.Running and (CFG.AutoThrow or manual) do
            local now = os.clock()
            local el = now - t0
            if now - T.lastScan > 0.08 then T:scan(now) end
            T:update(now)

            if State.meterLearned and meterObj and el > 1.2 then
                local it = T.items[meterObj]
                if it and it.n == 0 then
                    T.items[meterObj] = nil
                    meterObj, State.meterLearned = nil, false
                    log("[LỰC] thanh lực đã học không đổi -> bỏ, dò lại")
                end
            end

            local s, o = T:best()
            if s and s.v then
                active, activeS = o, s
                lastV, lastPower = s.v, s.v
                -- CHỈ tin thanh lực khi đã thấy nó reset (tụt thấp) hoặc đổi giá trị nhiều lần, và đã giữ tối thiểu MinHold
                local trusted = (s.sawLow or s.n >= 4) and el >= CFG.MinHold
                if trusted then
                    local rate = rateOf(s)
                    local rising = rate > 0.05 and rate < 12
                    if s.v >= goal - 0.002 then
                        released, vRel, rateRel = true, s.v, rate
                        break
                    elseif rising and s.v >= 0.6 then
                        local pred = s.v + rate * lead
                        if pred >= goal - rate * fdt * 0.5 then
                            released, vRel, rateRel = true, s.v, rate
                            break
                        end
                    end
                end
            end
            if el >= CFG.MaxCharge then break end
            if (not s) and el >= fallback then break end
            fdt = fdt * 0.9 + RunService.RenderStepped:Wait() * 0.1
        end
        mouseBtn(x, y, false)
        local tUp = os.clock()
        State.relTime = released and (tUp - t0) or nil
        State.relPow = vRel
        State.relSaw = activeS and activeS.sawLow or false

        local finalV, lastChange = lastV, nil
        if released and active and active.Parent then
            local lastVal = vRel
            local t1 = os.clock()
            while os.clock() - t1 < 0.5 do
                RunService.RenderStepped:Wait()
                local v = readObj(active)
                if v then
                    if lastVal and v < lastVal - 0.25 then break end
                    if lastVal and math.abs(v - lastVal) > 1e-4 then lastChange = os.clock() end
                    lastVal, finalV = v, v
                end
                if lastChange and os.clock() - lastChange > 0.12 then break end
                if (not lastChange) and os.clock() - t1 > 0.15 then break end
            end
            if CFG.AutoLead and finalV and finalV >= 0.3 and rateRel > 0.3 then
                local newLead = CFG.Lead
                if lastChange then
                    local L = lastChange - tUp
                    if L > 0.003 and L < 0.25 then newLead = CFG.Lead * 0.6 + L * 0.4 end
                elseif finalV < goal - 0.02 then
                    newLead = newLead - 0.01
                end
                newLead = math.clamp(newLead, 0, 0.25)
                if math.abs(newLead - CFG.Lead) > 0.001 then CFG.Lead = newLead; saveCfg() end
            end
        end

        if released and active and activeS and active.Parent and (not meterObj or State.meterLearned)
            and activeS.n >= 6 and (activeS.hi - activeS.lo) >= 0.4 then
            if meterObj ~= active then log("[LỰC] đã học thanh lực: " .. active:GetFullName()) end
            meterObj, State.meterLearned = active, true
        end

        if released then
            log(("[THROW] thả ở %.0f%% sau %.2fs (tốc %.1f/s), lực cuối %.0f%%, đoán trước %.0fms | %s"):format(
                (vRel or 0) * 100, tUp - t0, rateRel, (finalV or 0) * 100, CFG.Lead * 1000, dumpCand(T)))
        elseif lastV then
            log(("[THROW] hết giờ giữ (%.1fs), lực cuối %.0f%% | %s"):format(tUp - t0, lastV * 100, dumpCand(T)))
        else
            log(("[THROW] không thấy %% đổi, giữ %.1fs rồi thả -> dùng nút 'Chọn thanh lực'"):format(tUp - t0))
        end
        return released
    end

    function holdThrow(manual)
        State.holding = true
        local x, y
        local function timed(sec, tag)
            x, y = pickClickPoint()
            mouseBtn(x, y, false)
            pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
            task.wait(0.05)
            mouseBtn(x, y, true)
            local t0 = os.clock()
            while State.Running and (CFG.AutoThrow or manual) and os.clock() - t0 < sec do
                RunService.RenderStepped:Wait()
            end
            mouseBtn(x, y, false)
            log(("[THROW] %s: giữ %.3fs rồi nhả"):format(tag, os.clock() - t0))
            return true
        end
        local ok, res = pcall(function()
            if CFG.FixedHold then return timed(CFG.HoldTime, "cố định") end
            local hasMeter = meterObj and meterObj.Parent
            if CFG.CalTime >= 0.3 and (CFG.PreferCal or not hasMeter) then
                return timed(CFG.CalTime + 0.03, "hiệu chuẩn")
            end
            local rel = holdMeter(manual)
            -- chỉ ghi hiệu chuẩn khi lần đo đáng tin (đã thấy reset, giữ >= 0.3s, đạt ~100%)
            if rel and State.relTime and State.relTime >= 0.3 and State.relSaw and (State.relPow or 0) >= CFG.PowerGoal - 0.03 then
                CFG.CalTime = CFG.CalTime > 0 and (CFG.CalTime * 0.5 + State.relTime * 0.5) or State.relTime
                saveCfg()
                log(("[LỰC] hiệu chuẩn: %.3fs để đạt ~100%%"):format(CFG.CalTime))
            end
            return rel
        end)
        if not ok then
            log("[LOI giữ] " .. tostring(res))
            if x then mouseBtn(x, y, false) end
        end
        State.holding = false
        return ok and res
    end
end

------------------------------------------------------------------
-- MÁY BAY CỦA MÌNH (CameraSubject / vật mới sinh / chủ sở hữu / vật bay nhanh)
------------------------------------------------------------------
local inFlight, baseY, planeCache, reachedGate = false, nil, nil, false
local lastPlaneScan, lastHeavy, throwStartT = 0, 0, 0
local findPlane, cameraPlane

do
    local spawnInfo = setmetatable({}, {__mode = "k"})
    local OWNER_KEYS = {"OwnerUserId", "Owner", "UserId", "OwnerId", "Player", "PlayerName"}
    local function nameLooksPlane(n)
        n = n:lower()
        return n:find("plane", 1, true) or n:find("glider", 1, true) or n:find("aircraft", 1, true)
            or n:find("paper", 1, true) or n:find("máy bay", 1, true)
    end
    local function candPart(v)
        if v:IsA("BasePart") then return v end
        return v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)
    end

    local function recordSpawn(v)
        local part = candPart(v)
        local r = root()
        if part and r then
            spawnInfo[v] = {t = os.clock(), d = (part.Position - r.Position).Magnitude, named = nameLooksPlane(v.Name) and true or false}
        end
    end
    bind(workspace.DescendantAdded:Connect(function(v)
        if not (v:IsA("Model") or v:IsA("BasePart")) then return end
        if v:IsA("Terrain") then return end
        local named = nameLooksPlane(v.Name)
        if not (named or (os.clock() - throwStartT) < 4) then return end
        if lp.Character and v:IsDescendantOf(lp.Character) then return end
        if v:IsA("BasePart") then recordSpawn(v)
        else task.defer(function() if v.Parent then recordSpawn(v) end end) end
    end))

    function cameraPlane()
        local cam = workspace.CurrentCamera
        local cs = cam and cam.CameraSubject
        if not cs or cs:IsA("Humanoid") then return nil end
        if not (cs:IsA("BasePart") or cs:IsA("Model")) then return nil end
        if lp.Character and cs:IsDescendantOf(lp.Character) then return nil end
        if not cs:IsDescendantOf(workspace) then return nil end
        return cs
    end

    local function ownedByOther(v)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                if p.Character and v:IsDescendantOf(p.Character) then return true end
                local n = v.Name:lower()
                local pn = (v.Parent and v.Parent ~= workspace) and v.Parent.Name:lower() or ""
                local un, dn = p.Name:lower(), p.DisplayName:lower()
                if (#un >= 3 and n:find(un, 1, true)) or pn == un or pn == dn or n:find(tostring(p.UserId), 1, true) then
                    return true
                end
            end
        end
        for _, key in ipairs(OWNER_KEYS) do
            local a = v:GetAttribute(key)
            if a ~= nil and a ~= lp.UserId and a ~= lp.Name and a ~= lp.DisplayName and tostring(a) ~= tostring(lp.UserId) then
                return true
            end
        end
        local ov = v:FindFirstChild("Owner") or v:FindFirstChild("OwnerUserId")
        if ov and ov:IsA("ValueBase") then
            local val = ov.Value
            if val ~= lp and val ~= lp.UserId and val ~= lp.Name then return true end
        end
        return false
    end

    local function isMine(v)
        local id = flightId and flightId:lower()
        if id and v.Name:lower() == id then return true end
        for _, key in ipairs(OWNER_KEYS) do
            local a = v:GetAttribute(key)
            if a ~= nil and (a == lp.UserId or a == lp.Name or tostring(a) == tostring(lp.UserId)) then return true end
        end
        local ov = v:FindFirstChild("Owner") or v:FindFirstChild("OwnerUserId")
        if ov and ov:IsA("ValueBase") and (ov.Value == lp or ov.Value == lp.UserId or ov.Value == lp.Name) then return true end
        return false
    end

    function findPlane()
        if planeCache and planeCache.Parent then return planeCache end
        planeCache = nil
        local now = os.clock()
        if now - lastPlaneScan < 0.2 then return nil end
        lastPlaneScan = now

        -- 1) camera đang bám theo máy bay
        local cp = cameraPlane()
        if cp and (now - throwStartT) > 0.3 then
            planeCache = cp
            log("[BAY] nhận máy bay qua camera: " .. cp:GetFullName())
            return cp
        end

        -- 2) vật mới sinh gần chỗ ném (tên giống plane, hoặc bất kỳ vật không neo đang bay nhanh)
        local best, bestScore
        for v, si in pairs(spawnInfo) do
            if v.Parent and si.t >= throwStartT - 0.2 and si.d <= CFG.PlaneSpawnDist and not ownedByOther(v) then
                local ok = si.named
                if not ok then
                    local pt = candPart(v)
                    ok = pt and (not pt.Anchored) and pt.AssemblyLinearVelocity.Magnitude > 15
                end
                if ok then
                    local score = si.d - (si.named and 1000 or 0)
                    if not bestScore or score < bestScore then best, bestScore = v, score end
                end
            end
        end
        if best then
            planeCache = best
            log("[BAY] nhận máy bay của mình: " .. best:GetFullName())
            return best
        end

        -- 3) quét nặng (1.5s/lần): chủ sở hữu / vật bay nhanh nhất mà mình là network owner
        if now - lastHeavy < 1.5 then return nil end
        lastHeavy = now
        local fast, fastV
        local rr = root()
        local allowFast = rr and (now - throwStartT) > 0.6
            and (#Players:GetPlayers() <= 1 or type(isnetworkowner) == "function")
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and not (lp.Character and v:IsDescendantOf(lp.Character)) then
                if isMine(v) then
                    planeCache = v
                    return v
                end
                if allowFast and v:IsA("BasePart") and not v.Anchored then
                    local sp = v.AssemblyLinearVelocity.Magnitude
                    if sp > 25 and (not fastV or sp > fastV) and (v.Position - rr.Position).Magnitude < 400 then
                        local okOwn = true
                        if type(isnetworkowner) == "function" then
                            local ok2, res = pcall(isnetworkowner, v)
                            okOwn = ok2 and res
                        end
                        if okOwn and not ownedByOther(v) then fast, fastV = v, sp end
                    end
                end
            end
        end
        if fast then
            planeCache = fast
            log("[BAY] lấy vật bay nhanh nhất của mình: " .. fast:GetFullName())
            return fast
        end
        return nil
    end
end

local function planeRoot()
    local p = findPlane()
    if not p then return nil end
    return partFromPlane(p)
end

------------------------------------------------------------------
-- CỔNG (chỉ dùng khi KHÔNG có đích cuối; bỏ qua cổng quá gần / quá xa)
------------------------------------------------------------------
local GATE_KW = {"cổng", "cong", "gate", "finish", "goal", "đích", "dich", "portal", "ketthuc", "endzone"}
local gates, gateOverride, curGate, gateChosen = {}, nil, nil, false

local function gateStrong(g)
    if not g then return false end
    local n = viLower(g.Name)
    local pn = (g.Parent and g.Parent ~= workspace) and viLower(g.Parent.Name) or ""
    for _, k in ipairs({"finish", "goal", "đích", "dich", "ketthuc", "portal", "endzone"}) do
        if n:find(k, 1, true) or pn:find(k, 1, true) then return true end
    end
    return false
end

local function scanGates()
    gates = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not (lp.Character and v:IsDescendantOf(lp.Character)) then
            local n = viLower(v.Name)
            local pn = v.Parent and viLower(v.Parent.Name) or ""
            for _, k in ipairs(GATE_KW) do
                if n:find(k, 1, true) or pn:find(k, 1, true) then
                    gates[#gates + 1] = v
                    break
                end
            end
        end
    end
end

local function pickGate()
    if gateOverride and gates[gateOverride] and gates[gateOverride].Parent then
        return gates[gateOverride]
    end
    if State.gateSel and State.gateSel.Parent then return State.gateSel end
    local r = planeRoot() or root()
    if not r then return nil end
    local l = r.CFrame.LookVector
    local look = Vector3.new(l.X, 0, l.Z)
    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local best, bestScore
    for _, g in ipairs(gates) do
        if g.Parent then
            local d = g.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            local m = flat.Magnitude
            -- bỏ cổng gần người chơi (< GateMin) và cổng xa bất thường (> GateMax); chọn cổng GẦN NHẤT phía trước
            if m >= CFG.GateMin and m <= CFG.GateMax and flat.Unit:Dot(look) > 0.45 then
                local score = m - (gateStrong(g) and 800 or 0)
                if not bestScore or score < bestScore then best, bestScore = g, score end
            end
        end
    end
    return best
end

local function nearestGateTo(pos, maxd)
    if #gates == 0 then scanGates() end
    local best, bd
    for _, g in ipairs(gates) do
        if g.Parent then
            local d = (g.Position - pos).Magnitude
            if d <= maxd and (not bd or d < bd) then best, bd = g, d end
        end
    end
    return best
end

