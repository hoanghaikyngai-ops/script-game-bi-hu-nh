local function toggle(page, label, key, onChange)
    local b = new("TextButton", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(35, 40, 70),
        Text = "  " .. label, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Gotham, TextSize = 13}, page)
    new("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
    local led = new("Frame", {Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -26, 0.5, -7)}, b)
    new("UICorner", {CornerRadius = UDim.new(1, 0)}, led)
    local function refresh() led.BackgroundColor3 = CFG[key] and Color3.fromRGB(60, 255, 120) or Color3.fromRGB(90, 90, 110) end
    local obj = {}
    function obj:Set(v)
        CFG[key] = v and true or false
        refresh(); saveCfg()
        if onChange then onChange(CFG[key]) end
    end
    b.MouseButton1Click:Connect(function() obj:Set(not CFG[key]) end)
    refresh()
    if onChange and CFG[key] then task.defer(onChange, true) end
    return obj
end

local function stepper(page, label, key, step, min, max, dec, onChange)
    local row = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(35, 40, 70)}, page)
    new("UICorner", {CornerRadius = UDim.new(0, 8)}, row)
    new("TextLabel", {Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1,
        Text = label, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left}, row)
    local val = new("TextLabel", {Size = UDim2.fromOffset(44, 32), Position = UDim2.new(1, -86, 0, 0), BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(120, 220, 255), Font = Enum.Font.GothamBold, TextSize = 13}, row)
    local function refresh() val.Text = string.format("%." .. dec .. "f", CFG[key]) end
    local function sb(txt, x, d)
        local b = new("TextButton", {Size = UDim2.fromOffset(20, 22), Position = UDim2.new(1, x, 0.5, -11),
            BackgroundColor3 = Color3.fromRGB(70, 110, 230), Text = txt, TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.GothamBold, TextSize = 14}, row)
        new("UICorner", {CornerRadius = UDim.new(0, 6)}, b)
        b.MouseButton1Click:Connect(function()
            CFG[key] = math.clamp(CFG[key] + d * step, min, max); refresh(); saveCfg()
            if onChange then onChange(CFG[key]) end
        end)
    end
    sb("-", -108, -1); sb("+", -26, 1)
    refresh()
end

