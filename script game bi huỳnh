local function clickX2Strength()
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for btn in pairs(x2Clicked) do
        if not btn.Parent or not visibleChain(btn) then x2Clicked[btn] = nil end
    end
    for _, v in ipairs(pg:GetDescendants()) do
        if (v:IsA("TextButton") or v:IsA("TextLabel")) and visibleChain(v) then
            local btn = v:IsA("GuiButton") and v or v:FindFirstAncestorWhichIsA("GuiButton")
            local label = (v.Text .. " " .. v.Name):lower():gsub("<[^>]->", "")
            local isStrength = label:find("x2 sức mạnh", 1, true) or label:find("x2 suc manh", 1, true)
            local isPower = label:find("x2 power", 1, true)
            if btn and isStrength and not isPower and visibleChain(btn) and not x2Clicked[btn] then
                local fullLabel = (btn.Name .. " " .. (btn:IsA("TextButton") and btn.Text or "")):lower()
                if not fullLabel:find("x2 power", 1, true) then
