local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    local bb = inst:FindFirstAncestorWhichIsA("BillboardGui")
    if bb and bb.Adornee then return partOf(bb.Adornee) end
    local p = inst.Parent
    while p and p ~= workspace and p ~= game do
        if p:IsA("BasePart") then return p end
        if p:IsA("Model") then
            local bp = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
            if bp then return bp end
        end
        p = p.Parent
    end
end

