        local x, y = pickClickPoint()
        pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
        local t0 = os.clock()
        mouseBtn(x, y, true)
        local goal = CFG.PowerGoal
        local lead = math.clamp(CFG.Lead, 0, 0.25)
        local released, active, activeS, vRel, lastV, rateRel = false, nil, nil, nil, nil, 0
        local fdt = 1 / 60

        while State.Running and (CFG.AutoThrow or manual) do
            local now = os.clock()
            local el = now - t0
            if now - T.lastScan > 0.08 then T:scan(now) end
            T:update(now)

            if State.meterLearned and meterObj and el > 1.2 then
                local it = T.items[meterObj]
                if it and it.n == 0 then
                    T.items[meterObj] = nil
                    meterObj, State.meterLearned = nil, false
                    log("[LỰC] thanh lực đã học không đổi -> bỏ, dò lại")
                end
            end

            local s, o = T:best()
            if s and s.v then
                active, activeS = o, s
                lastV, lastPower, lastMeterName = s.v, s.v, o.Name
                local trusted = s.manual or s.n >= 3
                if trusted and el > 0.05 then
                    local rate = rateOf(s)
                    local rising = rate > 0.05 and rate < 12
                    if s.v >= goal - 0.002 then
                        released, vRel, rateRel = true, s.v, rate
                        break
                    elseif rising and s.v >= 0.6 then
                        local pred = s.v + rate * lead
                        if pred >= goal - rate * fdt * 0.5 then
                            released, vRel, rateRel = true, s.v, rate
                            break
                        end
                    end
                end
            end
            if el >= CFG.MaxCharge then break end
            if (not s) and el >= math.max(CFG.ChargeHold, 2) then break end
            fdt = fdt * 0.9 + RunService.RenderStepped:Wait() * 0.1
        end
        mouseBtn(x, y, false)
        local tUp = os.clock()
        State.relTime = released and (tUp - t0) or nil
        State.relPow = vRel

        local finalV, lastChange = lastV, nil
        if released and active and active.Parent then
            local lastVal = vRel
            local t1 = os.clock()
            while os.clock() - t1 < 0.5 do
                RunService.RenderStepped:Wait()
                local v = readObj(active)
                if v then
                    if lastVal and v < lastVal - 0.25 then break end
                    if lastVal and math.abs(v - lastVal) > 1e-4 then lastChange = os.clock() end
                    lastVal, finalV = v, v
                end
                if lastChange and os.clock() - lastChange > 0.12 then break end
                if (not lastChange) and os.clock() - t1 > 0.15 then break end
            end

            if CFG.AutoLead and finalV and finalV >= 0.3 and rateRel > 0.3 then
                local newLead = CFG.Lead
                if lastChange then
                    local L = lastChange - tUp
                    if L > 0.003 and L < 0.25 then newLead = CFG.Lead * 0.6 + L * 0.4 end
                elseif finalV < goal - 0.02 then
                    newLead = newLead - 0.01
                end
                newLead = math.clamp(newLead, 0, 0.25)
                if math.abs(newLead - CFG.Lead) > 0.001 then CFG.Lead = newLead; saveCfg() end
            end
        end

        if released and active and activeS and active.Parent and (not meterObj or State.meterLearned)
            and activeS.n >= 6 and (activeS.hi - activeS.lo) >= 0.4 then
            if meterObj ~= active then log("[LỰC] đã học thanh lực: " .. active:GetFullName()) end
            meterObj, State.meterLearned = active, true
        end

        if released then
            log(("[THROW] thả ở %.0f%% (tốc %.1f/s), lực cuối %.0f%%, đoán trước %.0fms | %s"):format(
                (vRel or 0) * 100, rateRel, (finalV or 0) * 100, CFG.Lead * 1000, dumpCand(T)))
        elseif lastV then
            log(("[THROW] hết giờ giữ, lực cuối %.0f%% | %s"):format(lastV * 100, dumpCand(T)))
        else
            log("[THROW] không thấy % nào đang đổi -> dùng nút 'Chọn thanh lực'")
        end
        return released
    end

    function holdThrow(manual)
        State.holding = true
        local x, y
        local function timed(sec, tag)
            x, y = pickClickPoint()
            mouseBtn(x, y, false)
            pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
            task.wait(0.05)
            mouseBtn(x, y, true)
            local t0 = os.clock()
            while State.Running and (CFG.AutoThrow or manual) and os.clock() - t0 < sec do
                RunService.RenderStepped:Wait()
            end
            mouseBtn(x, y, false)
            log(("[THROW] %s: giữ %.3fs rồi nhả"):format(tag, os.clock() - t0))
            return true
        end
        local ok, res = pcall(function()
            if CFG.FixedHold then return timed(CFG.HoldTime, "cố định") end
            local hasMeter = meterObj and meterObj.Parent
            if CFG.CalTime > 0 and (CFG.PreferCal or not hasMeter) then
                return timed(CFG.CalTime, "hiệu chuẩn")
            end
            local rel = holdMeter(manual)
            if rel and State.relTime and (State.relPow or 0) >= CFG.PowerGoal - 0.03 then
                CFG.CalTime = CFG.CalTime > 0 and (CFG.CalTime * 0.5 + State.relTime * 0.5) or State.relTime
                saveCfg()
                log(("[LỰC] hiệu chuẩn: %.3fs để đạt ~100%%"):format(CFG.CalTime))
            end
            return rel
        end)
        if not ok then
            log("[LOI giữ] " .. tostring(res))
            if x then mouseBtn(x, y, false) end
        end
        State.holding = false
        return ok and res
    end
end

