local meterObj, pickMode, lastPower, lastMeterName = nil, false, nil, nil
local METER_KW = {"power", "charge", "lực", "luc", "force", "meter", "strength", "throw"}

local function nameHas(inst)
    local p, n = inst, 0
    while p and p ~= game and n < 5 do
        local s = viLower(p.Name)
        for _, k in ipairs(METER_KW) do
            if s:find(k, 1, true) then return true end
        end
        p = p.Parent
        n += 1
    end
    return false
end

local function visibleChain(o)
    local p = o
    while p and p:IsA("GuiObject") do
        if not p.Visible then return false end
        p = p.Parent
    end
    local sg = o:FindFirstAncestorWhichIsA("ScreenGui")
    return (not sg) or sg.Enabled
end

local function readObj(o)
    if not (o and o.Parent) then return nil end
    if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
        local n = tonumber(o.Text:match("(%d+%.?%d*)%s*%%"))
        return n and n / 100 or nil
    end
    if o:IsA("GuiObject") then
        local size, par = o.AbsoluteSize, o.Parent
        local best
        local horiz = size.X >= size.Y
        for _, c in ipairs(o:GetChildren()) do
            if c:IsA("GuiObject") and not c:IsA("TextLabel") and c.Visible then
                local den = horiz and size.X or size.Y
                if den > 0 then
                    local cs = c.AbsoluteSize
                    local r = (horiz and cs.X or cs.Y) / den
                    if not best or r > best then best = r end
                end
            end
        end
        if best then return math.clamp(best, 0, 1) end
        if par and par:IsA("GuiObject") then
            local ps = par.AbsoluteSize
            local hz = ps.X >= ps.Y
            local den = hz and ps.X or ps.Y
            if den > 0 then return math.clamp((hz and size.X or size.Y) / den, 0, 1) end
        end
    end
    return nil
end

