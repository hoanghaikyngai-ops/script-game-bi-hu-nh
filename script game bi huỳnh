                        local ok = pcall(function()
                            for _, c in ipairs(getconnections(btn.Activated)) do c:Fire(); fired = true end
                        end)
                        if not ok then fired = false end
                    end
                    if not fired then pcall(function() btn:Activate() end) end
                    log("[FAM] đã nhấn x2 sức mạnh")
                    return
                end
            end
        end
    end
